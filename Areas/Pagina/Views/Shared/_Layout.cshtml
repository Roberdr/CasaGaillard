@using CasaGaillard.Models
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CASA GAILLARD S.A.</title>
    @Styles.Render("~/bundles/styles")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="public-body">
    <header class="public-navbar navbar navbar-default navbar-fixed-top">
        <div class="container public-navbar__inner">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#public-navbar">
                    <span class="sr-only">Abrir menú</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("CASA GAILLARD S.A.", "Index", "Pagina", new { area = "Pagina" }, new { @class = "navbar-brand public-brand" })
                <span class="public-brand__tagline hidden-xs">Distribución, servicios y seguridad</span>
            </div>
            <div class="collapse navbar-collapse" id="public-navbar">
                <ul class="nav navbar-nav navbar-right public-nav">
                    <li>@Html.ActionLink("Inicio", "Index", "Pagina", new { area = "Pagina" }, null)</li>
                    <li>@Html.ActionLink("Contacto", "Contacto", "Pagina", new { area = "Pagina" }, null)</li>
                </ul>
                <div class="public-navbar__utility">
                    @if (Request.IsAuthenticated)
                    {
                        @Html.ActionLink("Área interna", "Index", "Home", new { area = "Mantenimiento" }, new { @class = "public-utility-link" })
                        <a class="public-utility-link" href="javascript:document.getElementById('logoutForm').submit()">Cerrar sesión</a>
                    }
                    else
                    {
                        @Html.ActionLink("Iniciar sesión", "Login", "Account", new { area = "" }, new { @class = "public-utility-link" })
                    }
                </div>
            </div>
        </div>
    </header>

    @if (Request.IsAuthenticated)
    {
        using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutForm", @class = "hidden" }))
        {
            @Html.AntiForgeryToken()
        }
    }

    <main class="public-main">
        @if (TempData["LoginMessage"] != null)
        {
            <div class="container">
                <div class="alert alert-info" role="alert">@TempData["LoginMessage"]</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container public-footer__inner">
            <div>
                <strong>Casa Gaillard S.A.</strong>
                <span>Información pública, servicios y seguridad</span>
            </div>
            <div class="text-right">
                <span>&copy; @DateTime.Now.Year</span>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/js")
    @RenderSection("scripts", required: false)
</body>
</html>
