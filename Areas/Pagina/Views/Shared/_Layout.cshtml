@using CasaGaillard.Models
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CASA GAILLARD S.A.</title>
    @Styles.Render("~/bundles/styles")
    @RenderSection("Styles", required: false)
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="public-body container">
    <nav class="navbar sticky-top navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            @Html.ActionLink("CASA GAILLARD S.A.", "Index", "Pagina", new { area = "Pagina" }, new { @class = "navbar-brand" })
            <!--
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#public-navbar" aria-controls="public-navbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            -->
            <div class="collapse navbar-collapse d-flex" id="public-navbar">
                <ul class=" navbar-nav">
                    <li>@Html.ActionLink("Contacto", "Contacto", "Pagina", new { area = "Pagina" }, new { @class = "nav-link" })</li>

               
                @if (Request.IsAuthenticated)
                    {
                       
                        <li class="nav-item">
                            @Html.ActionLink("Área interna", "Index", "Home", new { area = "Mantenimiento" }, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="javascript:document.getElementById('logoutForm').submit()">Cerrar sesión</a>
                        </li>
                       
                    }
                    else
                    {
                        @Html.ActionLink("Iniciar sesión", "Login", "Account", new { area = "" }, new { @class = "form-control nav-item" })
                    }
               </ul>
            </div>
        </div>
    </nav>

    @if (Request.IsAuthenticated)
    {
        using (Html.BeginForm("LogOff", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutForm", @class = "hidden d-flex" }))
        {
            @Html.AntiForgeryToken()
        }
    }

    <main class="public-main">
        @if (TempData["LoginMessage"] != null)
        {
            <div class="container">
                <div class="alert alert-info" role="alert">@TempData["LoginMessage"]</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container public-footer__inner">
            <div>
                <strong>Casa Gaillard S.A.</strong>
                <span>Información pública, servicios y seguridad</span>
            </div>
            <div class="text-right">
                <span>&copy; @DateTime.Now.Year</span>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/js")
    @RenderSection("Scripts", required: false)
</body>
</html>
