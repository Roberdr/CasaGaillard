@model CasaGaillard.Models.ViewModels.PaginaInicioViewModel

@{
    ViewBag.Title = "Inicio";
    var logo = Url.Content("~/Content/images/logo_gaillard.JPeG");
    var mainImage = Url.Content("~/Content/images/Quimica.jpeg");
    var foto1 = Url.Action("Imagen", "Pagina", new { area = "Pagina", archivo = "IMG_20201013_122605.jpg" });
    var foto2 = Url.Action("Imagen", "Pagina", new { area = "Pagina", archivo = "DSC_0122.JPG" });
    var foto3 = Url.Action("Imagen", "Pagina", new { area = "Pagina", archivo = "DSC_0296.JPG" });
    var foto4 = Url.Action("Imagen", "Pagina", new { area = "Pagina", archivo = "IMG_20201013_122550.jpg" });
    var contactBg = Url.Content("~/Content/images/fondo-cabecera-contacto.jpg");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.css" />
}

<section class="pagina-hero">
    <div class="container">
        <div class="hero-inner">
            <div class="hero-brand">
                <img src="@logo" alt="Casa Gaillard" />
            </div>
            <div class="hero-copy">
                <h1>Casa Gaillard S.A.</h1>
                <h3>Almacenaje y distribución de productos químicos a granel — desde 1924</h3>
                <p style="margin-top:12px; max-width:720px; color:#475569;">
                    Especialistas en suministro, logística y distribución para la industria y clientes profesionales en
                    las Islas Baleares. Soluciones seguras, trazables y con capacidad para manejo de cargas a granel.
                </p>
                <div class="hero-cta">
                    <a href="#contact" class="btn btn-primary">Contactar ahora</a>
                    <a href="#servicios" class="btn btn-outline-primary" style="margin-left:8px;">Nuestros servicios</a>
                </div>
            </div>
            <div class="hero-media">
                <img src="@mainImage" alt="Almacenaje y logística" class="pagina-hero-image" />
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="~/Scripts/Pagina/feather-init.js"></script>
}

<section class="pagina-features">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i data-feather="truck"></i>
                            </div>
                            <div>
                                <h4 class="feature-title">Logística propia</h4>
                                <p class="feature-desc">Flota propia para distribución y descarga en cliente, con contenedores cisterna.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon"><i data-feather="box"></i></div>
                            <div>
                                <h4 class="feature-title">Almacenaje seguro</h4>
                                <p class="feature-desc">Instalaciones en Polígono Son Castelló con zonas segregadas según compatibilidades.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon"><i data-feather="shield"></i></div>
                            <div>
                                <h4 class="feature-title">Cumplimiento y seguridad</h4>
                                <p class="feature-desc">Protocolos HSE, gestión de documentación y transporte ADR cuando procede.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-card">
                            <div class="feature-icon"><i data-feather="repeat"></i></div>
                            <div>
                                <h4 class="feature-title">Suministro a medida</h4>
                                <p class="feature-desc">Suministro a granel y envasado, adaptado a las necesidades del cliente.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="safety-panel">
                    <h5>Panel de seguridad</h5>
                    <p style="margin-bottom:6px;">Pictogramas y fichas de seguridad disponibles bajo petición.</p>
                    <ul>
                        <li>Transporte ADR</li>
                        <li>Almacenamiento segregado</li>
                        <li>Equipos EPI y formación continua</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pagina-gallery">
    <div class="container">
        <h3>Instalaciones</h3>
        <div class="row">
            <div class="col-md-3 gallery-item"><img src="@foto1" alt="" /></div>
            <div class="col-md-3 gallery-item"><img src="@foto2" alt="" /></div>
            <div class="col-md-3 gallery-item"><img src="@foto3" alt="" /></div>
            <div class="col-md-3 gallery-item"><img src="@foto4" alt="" /></div>
        </div>
    </div>
</section>

<section id="servicios" class="public-home-section public-home-copy">
    <div class="container">
        <h2>Nuestra actividad</h2>
        <p>Nos ubicamos en el Polígono de Son Castelló, desde donde operamos con un amplio catálogo de productos químicos a granel y envasados, atendiendo a industria y clientes profesionales.</p>
        <p>Contamos con capacidad de importación, almacenamiento y entrega local, así como servicios de descarga en destino con vehículos cisterna.</p>
    </div>
</section>

<section id="contact" class="pagina-cta">
    <div class="container d-flex" style="background-image: url('@contactBg'); background-size: cover; background-position: center; border-radius:8px; padding:18px;">
        <div>
            <h4>¿Necesita suministro o asesoramiento técnico?</h4>
            <p style="margin:0; color:#475569;">Contacte con nuestro departamento comercial y logístico para recibir una propuesta a medida.</p>
        </div>
        <div>
            <a class="btn btn-primary" href="mailto:info@casagaillard.example">Enviar correo</a>
            <a class="btn btn-outline-primary" href="tel:+34123456789" style="margin-left:8px;">Llámanos</a>
        </div>
    </div>
</section>
