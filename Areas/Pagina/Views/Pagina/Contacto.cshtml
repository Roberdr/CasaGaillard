@{
    ViewBag.Title = "Contacto";
}

<section class="public-section public-section--tight">
    <div class="container">
        <div class="public-page-head">
            <div>
                <span class="public-kicker">Contacto</span>
                <h1>Cómo encontrarnos</h1>
                <p class="text-muted">
                    Punto de entrada para consultas comerciales, coordinación técnica y ubicación de la empresa.
                </p>
            </div>
        </div>

        <div class="public-grid public-grid--three public-contact-summary">
            <article class="public-card public-card--intro">
                <span class="public-chip">Atención</span>
                <h4>Consultas comerciales</h4>
                <p>Para dudas sobre productos, servicios o disponibilidad general.</p>
            </article>
            <article class="public-card public-card--intro">
                <span class="public-chip public-chip--muted">Soporte</span>
                <h4>Coordinación técnica</h4>
                <p>Para cuestiones relacionadas con mantenimiento y operación interna.</p>
            </article>
            <article class="public-card public-card--intro">
                <span class="public-chip public-chip--alert">Ubicación</span>
                <h4>Son Castelló</h4>
                <p>La localización exacta se muestra en el mapa integrado de la página.</p>
            </article>
        </div>

        <div class="public-contact">
            <div class="public-contact__card">
                <h3>Casa Gaillard S.A.</h3>
                <p class="text-muted">Atención a clientes y soporte técnico.</p>
                <dl class="public-contact__list">
                    <div>
                        <dt>Teléfono</dt>
                        <dd>Disponible por canales internos</dd>
                    </div>
                    <div>
                        <dt>Correo</dt>
                        <dd>Disponible por canales internos</dd>
                    </div>
                    <div>
                        <dt>Ubicación</dt>
                        <dd>Consulta la localización en el mapa de la empresa</dd>
                    </div>
                </dl>
            </div>
            <div class="public-contact__map">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1536.926167667554!2d2.670083404707691!3d39.608008745604856!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1297933b2eea8ea3%3A0x34e829eb3c344e33!2sCasa%20Gaillard%20S.A.!5e0!3m2!1ses!2ses!4v1604765618220!5m2!1ses!2ses"
                    class="public-map"
                    allowfullscreen=""
                    loading="lazy"></iframe>
            </div>
        </div>
    </div>
</section>
