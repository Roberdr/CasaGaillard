@model CasaGaillard.Models.ViewModels.UbicacionCatalogoViewModel
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
<div class="form-group">@Html.LabelFor(m => m.Codigo, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", maxlength = "50" })@Html.ValidationMessageFor(m => m.Codigo)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Nombre, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "150" })@Html.ValidationMessageFor(m => m.Nombre)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Descripcion, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = "3", maxlength = "300" })@Html.ValidationMessageFor(m => m.Descripcion)</div></div>
