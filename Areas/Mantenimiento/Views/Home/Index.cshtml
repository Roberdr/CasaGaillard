@model IEnumerable<CasaGaillard.Areas.Mantenimiento.Controllers.HomeController.UltimasRevisiones>
@{
    ViewBag.Title = "Home Page";
}

<div class="jumbotron">
    <h1>CASA GAILLARD S.A.</h1>
    <p class="lead">Aplicación para el control del mantenimiento en general de la empresa.</p>
    @*<p><a href="#" class="btn btn-primary btn-lg">Learn more &raquo;</a></p>*@
</div>

<div class="row">
   
    <div class="col-md-4">
        <h3>Revisiones de Cubas</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th class="col-md-4">Matrícula</th>
                        <th class="col-md-5">Validez</th>
                        <th class="col-md-3">Tipo</th>
                    </tr>

                </thead>
                <tbody>
                    @if (ViewBag.Revis != null)
                {
                    foreach (var c in ViewBag.Revis)
                    {
                        DateTime? validaHasta = c.ValidaHasta;
                        <tr>
                            <td class="col-md-4">@c.MatriculaCuba</td>
                            <td class="col-md-5">@(validaHasta.HasValue ? validaHasta.Value.ToString("d") : "N/D")</td>
                            <td class="col-md-3">@c.DescripcionProxima</td>
                        </tr>
                    }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-muted">No hay revisiones de cuba para mostrar.</td>
                        </tr>
                    }
                </tbody>
            </table>

        <p><a class="btn btn-default" href="#">Más &raquo;</a></p>
    </div>
  
    <div class="col-md-4">
        <h3>Próximas ITVs de vehículos</h3>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th class="col-md-4">Matrícula</th>
                    <th class="col-md-5">Validez</th>
                    <th class="col-md-3">Tipo</th>
                </tr>

            </thead>
            <tbody>
                @if (ViewBag.RevisV != null)
                {
                    foreach (var c in ViewBag.RevisV)
                    {
                        DateTime? caducidad = c.Caducidad;
                        <tr>
                            <td class="col-md-4">@c.MatriculaVehiculo</td>
                            <td class="col-md-5">@(caducidad.HasValue ? caducidad.Value.ToString("d") : "N/D")</td>
                            <td class="col-md-3">@c.TipoRevision</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-muted">No hay ITV próximas para mostrar.</td>
                    </tr>
                }
            </tbody>
        </table>
        <p><a class="btn btn-default" href="#">Más &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h3>Tareas de mantenimiento</h3>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Estado</th>
                    <th>Prioridad</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Tareas != null)
                {
                    foreach (var t in ViewBag.Tareas)
                    {
                        <tr>
                            <td>@t.Codigo</td>
                            <td>@t.Estado</td>
                            <td>@t.Prioridad</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-muted">No hay tareas registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
        <p>@Html.ActionLink("Ver tareas", "Index", "TareasMantenimiento", new { area = "Mantenimiento" }, new { @class = "btn btn-default" })</p>
    </div>
</div>
