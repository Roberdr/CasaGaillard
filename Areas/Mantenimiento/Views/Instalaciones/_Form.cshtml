@model CasaGaillard.Models.ViewModels.InstalacionFormViewModel
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(m => m.Id)

<div class="form-group">@Html.LabelFor(m => m.Codigo, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", maxlength = "50" })@Html.ValidationMessageFor(m => m.Codigo)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Nombre, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "255" })@Html.ValidationMessageFor(m => m.Nombre)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Descripcion, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = "3" })</div></div>
<div class="form-group">@Html.LabelFor(m => m.TipoInstalacionId, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.DropDownListFor(m => m.TipoInstalacionId, Model.Tipos, "-- Sin tipo --", new { @class = "form-control" })@Html.ValidationMessageFor(m => m.TipoInstalacionId)</div></div>
<div class="form-group">@Html.LabelFor(m => m.UbicacionId, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.DropDownListFor(m => m.UbicacionId, Model.Ubicaciones, "-- Sin ubicación --", new { @class = "form-control" })@Html.ValidationMessageFor(m => m.UbicacionId)</div></div>
<div class="form-group">@Html.LabelFor(m => m.ResponsablePersonaId, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.DropDownListFor(m => m.ResponsablePersonaId, Model.Responsables, "-- Sin responsable --", new { @class = "form-control" })@Html.ValidationMessageFor(m => m.ResponsablePersonaId)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Estado, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.DropDownListFor(m => m.Estado, new SelectList(new[] { "ACTIVA", "PARADA", "MANTENIMIENTO", "FUERA_SERVICIO" }, Model.Estado), new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Estado)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Criticidad, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Criticidad, new { @class = "form-control", type = "number", min = "1", max = "5" })@Html.ValidationMessageFor(m => m.Criticidad)</div></div>
<div class="form-group">@Html.LabelFor(m => m.FechaPuestaMarcha, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.FechaPuestaMarcha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })@Html.ValidationMessageFor(m => m.FechaPuestaMarcha)</div></div>
<div class="form-group">@Html.LabelFor(m => m.FechaBaja, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.FechaBaja, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })@Html.ValidationMessageFor(m => m.FechaBaja)</div></div>
<div class="form-group">@Html.LabelFor(m => m.CodigoPlano, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.CodigoPlano, new { @class = "form-control", maxlength = "50" })</div></div>
<div class="form-group"><div class="col-md-offset-2 col-md-10">@Html.CheckBoxFor(m => m.CriticaProduccion) @Html.LabelFor(m => m.CriticaProduccion)</div></div>
<div class="form-group"><div class="col-md-offset-2 col-md-10">@Html.CheckBoxFor(m => m.CriticaSeguridad) @Html.LabelFor(m => m.CriticaSeguridad)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Observaciones, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = "3" })</div></div>
