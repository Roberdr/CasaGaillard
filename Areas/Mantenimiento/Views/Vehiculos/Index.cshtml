@model IEnumerable<CasaGaillard.Models.Vehiculo>

@{
    ViewBag.Title = "Vehículos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Vehículos</h2>
    @Html.ActionLink("Crear vehículo", "AddOrEdit", null, new { @class = "btn btn-success" })
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped table-bordered">
        <thead class="thead-light">
            <tr>
                <th>Tipo</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Matrícula</th>
                <th>PMA</th>
                <th>TARA</th>
                <th>Carga útil</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.TipoVehiculo.Vehiculo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Marca)</td>
                    <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                    <td>@Html.DisplayFor(modelItem => item.MatriculaVehiculo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Pma)</td>
                    <td>@Html.DisplayFor(modelItem => item.Tara)</td>
                    <td>@Html.DisplayFor(modelItem => item.CargaUtil)</td>
                    <td class="text-nowrap">
                        @Html.ActionLink("Edit", "AddOrEdit", new { id = item.ID }) |
                        @Html.ActionLink("Details", "Details", new { id = item.ID }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.ID })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
