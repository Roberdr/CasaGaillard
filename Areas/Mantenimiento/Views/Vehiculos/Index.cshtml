@model CasaGaillard.Models.ViewModels.VehiculosIndexViewModel
@using System.Collections.Generic

@{
    ViewBag.Title = "Vehículos";
    bool incluirBajas = ViewBag.IncluirBajas == true;
    var matriculas = ViewBag.Matriculas as IEnumerable<string> ?? new string[0];
    var marcas = ViewBag.Marcas as IEnumerable<string> ?? new string[0];
    var modelos = ViewBag.Modelos as IEnumerable<string> ?? new string[0];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Vehículos</h2>
    <div>
        @if (incluirBajas)
        {
            @Html.ActionLink("Ocultar bajas", "Index", new { incluirBajas = false }, new { @class = "btn btn-outline-secondary" })
        }
        else
        {
            @Html.ActionLink("Ver bajas", "Index", new { incluirBajas = true }, new { @class = "btn btn-outline-secondary" })
        }
        @Html.ActionLink("Crear vehículo", "AddOrEdit", null, new { @class = "btn btn-success" })
    </div>
</div>
@using (Html.BeginForm("Index", "Vehiculos", FormMethod.Get))
{
    <div class="row mb-3">

        <div class="col-md-2">
            @Html.Label("Matrícula")
            @Html.TextBox("matricula", Request["matricula"], new { @class = "form-control", list = "matriculas-disponibles", autocomplete = "off", onchange = "this.form.submit()" })
            <datalist id="matriculas-disponibles">
                @foreach (string matricula in matriculas)
                {
                    <option value="@matricula"></option>
                }
            </datalist>
        </div>

        <div class="col-md-2">
            @Html.Label("Marca")
            @Html.TextBox("marca", Request["marca"], new { @class = "form-control", list = "marcas-disponibles", autocomplete = "off", onchange = "this.form.submit()" })
            <datalist id="marcas-disponibles">
                @foreach (string marca in marcas)
                {
                    <option value="@marca"></option>
                }
            </datalist>
        </div>

        <div class="col-md-2">
            @Html.Label("Modelo")
            @Html.TextBox("modelo", Request["modelo"], new { @class = "form-control", list = "modelos-disponibles", autocomplete = "off", onchange = "this.form.submit()" })
            <datalist id="modelos-disponibles">
                @foreach (string modelo in modelos)
                {
                    <option value="@modelo"></option>
                }
            </datalist>
        </div>

        <div class="col-md-2">
            @Html.Label("Estado")
            @Html.DropDownList("estado",
                new SelectList(new[] { "Activo", "Inactivo", "Baja" }),
                "Todos",
                new { @class = "form-control", onchange = "this.form.submit()" })
        </div>

        <div class="col-md-2">
            @Html.Label("Tipo")
            @Html.DropDownList("tipo",
                new SelectList(new[] { "Camión", "Furgón", "Turismo", "Remolque", "Plataforma", "Tractora" }),
                "Todos",
                new { @class = "form-control", onchange = "this.form.submit()" })
        </div>

        <div class="col-md-2 mt-4">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
    </div>
}


<div class="table-responsive">
    <table class="table table-sm table-striped table-bordered">
        <thead class="thead-light">
            <tr>
                <th>Tipo</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Matrícula</th>
                <th>PMA</th>
                <th>TARA</th>
                <th>Carga útil</th>
                @if (incluirBajas)
                {
                    <th>Estado</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PagedList)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.TipoVehiculo.Vehiculo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Marca)</td>
                    <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                    <td>@Html.DisplayFor(modelItem => item.MatriculaVehiculo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Pma)</td>
                    <td>@Html.DisplayFor(modelItem => item.Tara)</td>
                    <td>@Html.DisplayFor(modelItem => item.CargaUtil)</td>
                    @if (incluirBajas)
                    {
                        <td>
                            @if (item.Baja == true)
                            {
                                <span class="label label-default">Baja</span>
                            }
                            else
                            {
                                <span class="label label-success">Activo</span>
                            }
                        </td>
                    }
                    <td class="text-nowrap">
                        @Html.ActionLink("Edit", "AddOrEdit", new { id = item.ID }) |
                        @Html.ActionLink("Details", "Details", new { id = item.ID }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.ID })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model?.PagedList != null && Model.PagedList.PageCount > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination">

            @if (Model.PagedList.HasPreviousPage)
            {
                <li class="page-item">
                    @Html.ActionLink("«", "Index", new
                    {
                        page = Model.PagedList.PageNumber - 1,
                        matricula = Request["matricula"],
                        marca = Request["marca"],
                        modelo = Request["modelo"],
                        estado = Request["estado"],
                        tipo = Request["tipo"]
                    }, new { @class = "page-link" })
                </li>
            }

            @for (int i = 1; i <= Model.PagedList.PageCount; i++)
            {
                var activeClass = i == Model.PagedList.PageNumber ? "active" : string.Empty;
            <li class="page-item @(activeClass)">
                @Html.ActionLink(i.ToString(), "Index", new
                {
                    page = i,
                    matricula = Request["matricula"],
                    marca = Request["marca"],
                    modelo = Request["modelo"],
                    estado = Request["estado"],
                    tipo = Request["tipo"]
                }, new { @class = "page-link" })
            </li>
            }

            @if (Model.PagedList.HasNextPage)
            {
                <li class="page-item">
                    @Html.ActionLink("»", "Index", new
                    {
                        page = Model.PagedList.PageNumber + 1,
                        matricula = Request["matricula"],
                        marca = Request["marca"],
                        modelo = Request["modelo"],
                        estado = Request["estado"],
                        tipo = Request["tipo"]
                    }, new { @class = "page-link" })
                </li>
            }

        </ul>
    </nav>
}
