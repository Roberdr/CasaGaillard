@model CasaGaillard.Models.ViewModels.EquipoFormViewModel
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(m => m.Id)

<div class="form-group">@Html.LabelFor(m => m.InstalacionId, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.DropDownListFor(m => m.InstalacionId, Model.Instalaciones, "-- Selecciona instalación --", new { @class = "form-control" })@Html.ValidationMessageFor(m => m.InstalacionId)</div></div>
<div class="form-group">@Html.LabelFor(m => m.EquipoPadreId, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.DropDownListFor(m => m.EquipoPadreId, Model.EquiposPadre, "-- Equipo principal --", new { @class = "form-control" })@Html.ValidationMessageFor(m => m.EquipoPadreId)</div></div>
<div class="form-group">@Html.LabelFor(m => m.TipoElemento, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.DropDownListFor(m => m.TipoElemento, Model.TiposElemento, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.TipoElemento)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Codigo, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", maxlength = "50" })@Html.ValidationMessageFor(m => m.Codigo)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Nombre, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "255" })@Html.ValidationMessageFor(m => m.Nombre)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Descripcion, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = "3" })</div></div>
<div class="form-group">@Html.LabelFor(m => m.Fabricante, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Fabricante, new { @class = "form-control", maxlength = "150" })</div></div>
<div class="form-group">@Html.LabelFor(m => m.Modelo, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Modelo, new { @class = "form-control", maxlength = "150" })</div></div>
<div class="form-group">@Html.LabelFor(m => m.NumeroSerie, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.NumeroSerie, new { @class = "form-control", maxlength = "100" })</div></div>
<div class="form-group">@Html.LabelFor(m => m.Potencia, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Potencia, new { @class = "form-control", type = "number", step = "0.001", min = "0" })@Html.ValidationMessageFor(m => m.Potencia)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Caudal, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Caudal, new { @class = "form-control", type = "number", step = "0.001", min = "0" })@Html.ValidationMessageFor(m => m.Caudal)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Presion, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Presion, new { @class = "form-control", type = "number", step = "0.001", min = "0" })@Html.ValidationMessageFor(m => m.Presion)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Voltaje, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Voltaje, new { @class = "form-control", type = "number", step = "0.001", min = "0" })@Html.ValidationMessageFor(m => m.Voltaje)</div></div>
<div class="form-group">@Html.LabelFor(m => m.FechaInstalacion, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.FechaInstalacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })@Html.ValidationMessageFor(m => m.FechaInstalacion)</div></div>
<div class="form-group">@Html.LabelFor(m => m.FechaBaja, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.FechaBaja, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })@Html.ValidationMessageFor(m => m.FechaBaja)</div></div>
<div class="form-group"><div class="col-md-offset-2 col-md-10">@Html.CheckBoxFor(m => m.Activo) @Html.LabelFor(m => m.Activo)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Observaciones, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = "3" })</div></div>
