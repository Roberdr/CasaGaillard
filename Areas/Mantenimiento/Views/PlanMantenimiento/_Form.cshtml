@model CasaGaillard.Models.PlanMantenimiento

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@Html.HiddenFor(model => model.PlanId)

<div class="form-group">
    @Html.LabelFor(model => model.Nombre, "Nombre del plan", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", maxlength = "150" })
        @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.EquipoId, "Equipo", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownList("EquipoId", null, "Sin equipo (plan de accesorio)", htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.EquipoId, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.AccesorioId, "Accesorio", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownList("AccesorioId", null, "Sin accesorio (plan de equipo)", htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.AccesorioId, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.Tipo, "Tipo", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownListFor(model => model.Tipo, new SelectList(new[] { "Preventivo", "Predictivo", "Legal", "Limpieza", "Calibración", "Otro" }, Model.Tipo), "Selecciona tipo", new { @class = "form-control" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.Descripcion, "Descripción", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = "3", maxlength = "1000" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.Activo, "Plan activo", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.CheckBoxFor(model => model.Activo)
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.FrecuenciaValor, "Frecuencia", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-4">
        @Html.TextBoxFor(model => model.FrecuenciaValor, new { @class = "form-control", type = "number", min = "1" })
    </div>
    <div class="col-md-4">
        @Html.DropDownListFor(model => model.FrecuenciaUnidad, new SelectList(new[] { "Días", "Semanas", "Meses", "Años", "Horas de uso" }, Model.FrecuenciaUnidad), "Unidad", new { @class = "form-control" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.AccesorioGrupoID, "Ubicación / grupo", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownList("AccesorioGrupoID", null, "Sin grupo asignado", htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.AccesorioGrupoID, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.PeriodicidadDias, "Periodicidad (días)", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.EditorFor(model => model.PeriodicidadDias, new { htmlAttributes = new { @class = "form-control", min = "1" } })
        @Html.ValidationMessageFor(model => model.PeriodicidadDias, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.UltimaEjecucion, "Última ejecución", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.UltimaEjecucion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(model => model.UltimaEjecucion, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(model => model.ProximaEjecucion, "Próxima ejecución", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.ProximaEjecucion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(model => model.ProximaEjecucion, "", new { @class = "text-danger" })
    </div>
</div>
