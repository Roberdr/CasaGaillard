@model IEnumerable<CasaGaillard.Models.Cuba>

@{
    ViewBag.Title = "Cubas";
    bool incluirBajas = ViewBag.IncluirBajas == true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Cubas</h2>
    <div>
        @if (incluirBajas)
        {
            @Html.ActionLink("Ocultar bajas", "Index", new { incluirBajas = false }, new { @class = "btn btn-outline-secondary" })
        }
        else
        {
            @Html.ActionLink("Ver bajas", "Index", new { incluirBajas = true }, new { @class = "btn btn-outline-secondary" })
        }
        @Html.ActionLink("Crear cuba", "Create", null, new { @class = "btn btn-success" })
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped table-bordered">
        <thead class="thead-light">
            <tr>
                <th>Matrícula</th>
                <th>Núm. cuadro</th>
                <th>Código</th>
                <th>Vehículo</th>
                <th>Material</th>
                <th>Peso bruto</th>
                <th>Tara</th>
                <th>Peso máximo</th>
                <th>Actualizada</th>
                @if (incluirBajas)
                {
                    <th>Estado</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.MatriculaCuba)</td>
                    <td>@Html.DisplayFor(modelItem => item.NumCuadro)</td>
                    <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Vehiculo.MatriculaVehiculo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Material.Material1)</td>
                    <td>@Html.DisplayFor(modelItem => item.PesoBruto)</td>
                    <td>@Html.DisplayFor(modelItem => item.Tara)</td>
                    <td>@Html.DisplayFor(modelItem => item.PesoMaxProducto)</td>
                    <td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
                    @if (incluirBajas)
                    {
                        <td>
                            @if (item.Baja)
                            {
                                <span class="label label-default">Baja</span>
                            }
                            else
                            {
                                <span class="label label-success">Activa</span>
                            }
                        </td>
                    }
                    <td class="text-nowrap">
                        @Html.ActionLink("Editar", "Edit", new { id = item.ID }) |
                        @Html.ActionLink("Detalle", "Details", new { id = item.ID }) |
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.ID })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
