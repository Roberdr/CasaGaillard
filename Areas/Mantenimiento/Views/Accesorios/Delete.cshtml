@model CasaGaillard.Models.Accesorio

@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Accesorio</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Material.Material1)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Material.Material1)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.TipoAccesorio.TipoAccesorio1)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TipoAccesorio.TipoAccesorio1)
        </dd>

    </dl>

@{
    var returnUrl = ViewBag.ReturnUrl as string;
}

@using (Html.BeginForm("Delete", "Accesorios", new { area = "Mantenimiento", id = Model.ID, returnUrl = returnUrl }, FormMethod.Post)) {
    @Html.AntiForgeryToken()

    @Html.Hidden("returnUrl", returnUrl)

    <div class="form-actions no-color">
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        @if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            <a href="@HttpUtility.HtmlEncode(returnUrl)">Volver</a>
        }
        else
        {
            @Html.ActionLink("Volver al listado", "Index")
        }
    </div>
}
</div>
