@model CasaGaillard.Models.Accesorio

@{
    ViewBag.Title = "Detalle del accesorio";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Mantenimiento</li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Accesorios", new { area = "Mantenimiento" })">Accesorios</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

<div class="page-header">
    <h1 class="page-title">@Model.TipoAccesorio.TipoAccesorio1 <small class="text-muted">@(!string.IsNullOrWhiteSpace(Model.Nombre) ? Model.Nombre : "")</small></h1>
    <div class="pull-right">
        @{ var returnUrl = Request.QueryString["returnUrl"]; }
        @Html.ActionLink("Editar", "Edit", new { id = Model.ID, returnUrl = returnUrl }, new { @class = "btn btn-primary" })
        @using (Html.BeginForm("Delete", "Accesorios", new { area = "Mantenimiento", id = Model.ID, returnUrl = returnUrl }, FormMethod.Post, new { id = "deleteForm", style = "display:inline-block; margin-left:6px;" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" id="btnDelete" class="btn btn-danger">Eliminar</button>
        }
        @if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            <a href="@HttpUtility.HtmlEncode(returnUrl)" class="btn btn-default" style="margin-left:6px;">Volver</a>
        }
        else
        {
            @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-default", style = "margin-left:6px;" })
        }
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h3>@(string.IsNullOrWhiteSpace(Model.Nombre) ? Model.TipoAccesorio.TipoAccesorio1 : Model.Nombre)</h3>
                        <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "(sin descripción)" : Model.Descripcion)</p>

                        <hr />

                        <h4>Detalles</h4>
                        @if (Model.DetallesAccesorio != null && Model.DetallesAccesorio.Any())
                        {
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Característica</th>
                                        <th class="text-right">Cantidad</th>
                                        <th class="text-right">Medida</th>
                                        <th>Unidad</th>
                                        <th>Tipo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.DetallesAccesorio)
                                    {
                                        <tr>
                                            <td>@(d.CaracteristicaAccesorio != null ? d.CaracteristicaAccesorio.CaracteristicaAccesorio1 : "-")</td>
                                            <td class="text-right">@(d.Cantidad.HasValue ? d.Cantidad.Value.ToString() : "-")</td>
                                            <td class="text-right">@(d.Medida.HasValue ? d.Medida.Value.ToString("0.##") : "-")</td>
                                            <td>@(d.Unidad != null ? d.Unidad.Unidad1 : "-")</td>
                                            <td>@(string.IsNullOrWhiteSpace(d.Tipo) ? "-" : d.Tipo)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">No se han definido detalles para este accesorio.</p>
                        }
                    </div>

                    <div class="col-md-4">
                        <h5>Metadatos</h5>
                        <ul class="list-unstyled">
                            <li><strong>Material:</strong> @Model.Material.Material1</li>
                            <li><strong>Familia:</strong> @(Model.Familia != null ? Model.Familia.Nombre : "-")</li>
                            <li><strong>Subfamilia:</strong> @(Model.Subfamilia != null ? Model.Subfamilia.Nombre : "-")</li>
                            <li><strong>Ubicación:</strong> @(Model.Ubicacion != null ? Model.Ubicacion.Nombre : "-")</li>
                            <li><strong>Fecha alta:</strong> @(Model.FechaAlta.HasValue ? Model.FechaAlta.Value.ToString("dd/MM/yyyy") : "-")</li>
                            <li><strong>Activo:</strong> @(Model.Activo ? "Sí" : "No")</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <strong>Fotos</strong>
            </div>
            <div class="card-body">
                @{ var fotos = ViewBag.Fotos as IEnumerable<CasaGaillard.Models.ViewModels.AccesorioFotoViewModel>; }

                @if (fotos != null && fotos.Any())
                {
                    <div class="row">
                        @foreach (var foto in fotos.Select((f, idx) => new { f, idx }))
                        {
                            <div class="col-xs-6 col-md-6 mb-2">
                                <a href="#" class="d-block" data-toggle="modal" data-target="#fotoModal" data-index="@foto.idx">
                                    <img src="@Url.Action("Foto", "Accesorios", new { area = "Mantenimiento", id = foto.f.ID })" alt="@foto.f.NombreOriginal" class="img-responsive img-thumbnail" />
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Modal lightbox con carousel -->
                    <div class="modal fade" id="fotoModal" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <div class="modal-body">
                                    <div id="fotosCarousel" class="carousel slide" data-ride="carousel">
                                        <div class="carousel-inner">
                                            @foreach (var foto in fotos.Select((f, idx) => new { f, idx }))
                                            {
                                                <div class="carousel-item @(foto.idx == 0 ? "active" : "")">
                                                    <img class="d-block w-100" src="@Url.Action("Foto", "Accesorios", new { area = "Mantenimiento", id = foto.f.ID })" alt="@foto.f.NombreOriginal" />
                                                    @if (!string.IsNullOrWhiteSpace(foto.f.NombreOriginal))
                                                    {
                                                        <div class="carousel-caption d-none d-md-block text-left">
                                                            <small>@foto.f.NombreOriginal</small>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <a class="carousel-control-prev" href="#fotosCarousel" role="button" data-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="sr-only">Anterior</span>
                                        </a>
                                        <a class="carousel-control-next" href="#fotosCarousel" role="button" data-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="sr-only">Siguiente</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">Todavía no hay fotos adjuntas.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/Accesorios/details.js"></script>
}
