@model CasaGaillard.Models.ViewModels.AccesorioFormViewModel

<div class="row">
    <div class="col-lg-3 col-md-6">
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(m => m.TipoAccesorioID)
                @Html.DropDownListFor(m => m.TipoAccesorioID, Model.TiposAccesorio, "-- Seleccione --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TipoAccesorioID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(m => m.FamiliaID)
                @Html.DropDownListFor(m => m.FamiliaID, Model.Familias, "-- Sin familia --", new { @class = "form-control", id = "FamiliaID" })
                @Html.ValidationMessageFor(m => m.FamiliaID, "", new { @class = "text-danger" })
            </div>
        </div> 
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(m => m.FotosAdjuntas)
                <input type="file" name="FotosAdjuntas" class="form-control" accept="image/*" multiple="multiple" />
                <p class="help-block">Puedes adjuntar varias fotos para ver el estado o los detalles del accesorio.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(m => m.MaterialID)
                @Html.DropDownListFor(m => m.MaterialID, Model.Materiales, "-- Seleccione --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MaterialID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(m => m.SubfamiliaID)
                @Html.DropDownListFor(m => m.SubfamiliaID, Model.Subfamilias, "-- Sin subfamilia --", new { @class = "form-control", id = "SubfamiliaID", data_selected = Model.SubfamiliaID, data_url = Url.Action("SubfamiliasPorFamilia", "Accesorios", new { area = "Mantenimiento" }) })
                @Html.ValidationMessageFor(m => m.SubfamiliaID, "", new { @class = "text-danger" })
            </div>
        </div>     
    </div>
    <div class="col-lg-6">
        @if (Model.FotosExistentes != null && Model.FotosExistentes.Any())
        {
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>Fotos actuales</strong>
                </div>
                <div class="panel-body">
                    <div class="row accesorio-fotos-galeria">
                        @foreach (var foto in Model.FotosExistentes)
                        {
                            <div class="col-xs-6 col-md-3 accesorio-foto-col">
                                <a href="@Url.Action("Foto", "Accesorios", new { area = "Mantenimiento", id = foto.ID })" target="_blank" class="accesorio-foto-link">
                                    <img src="@Url.Action("Foto", "Accesorios", new { area = "Mantenimiento", id = foto.ID })"
                                         alt="Foto del accesorio @(foto.NombreOriginal ?? foto.ID.ToString())"
                                         class="img-responsive accesorio-foto-thumb" />
                                </a>
                                @if (!string.IsNullOrWhiteSpace(foto.NombreOriginal))
                                {
                                    <div class="text-muted accesorio-foto-caption">@foto.NombreOriginal</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<script src="~/Scripts/Accesorios/subfamilias.js"></script>

@{
    // Mostrar los detalles dentro de la tabla editable más abajo; no duplicar lista
}

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>Detalles del accesorio</strong>
    </div>
    <div class="panel-body">
        <p class="text-muted">Rellena solo las líneas que necesites. Las filas vacías se ignorarán al guardar.</p>
        <div class="table-responsive">
            <table class="table table-condensed table-bordered accesorio-detalles-table">
                <thead>
                    <tr>
                        <th>Característica</th>
                        <th>Cantidad</th>
                        <th>Medida</th>
                        <th>Unidad</th>
                        <th>Tipo</th>
                        <th>Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Detalles.Count; i++)
                    {
                        <tr>
                            <td>
                                @Html.HiddenFor(m => m.Detalles[i].ID)
                                @Html.DropDownListFor(m => m.Detalles[i].CaracteristicaAccesorioID, new SelectList(Model.Caracteristicas, "Value", "Text", Model.Detalles[i].CaracteristicaAccesorioID), "-- Sin característica --", new { @class = "form-control input-sm" })
                            </td>
                            <td style="width: 100px;">
                                @Html.TextBoxFor(m => m.Detalles[i].Cantidad, new { @class = "form-control input-sm", type = "number", min = "0" })
                            </td>
                            <td style="width: 120px;">
                                @Html.TextBoxFor(m => m.Detalles[i].Medida, new { @class = "form-control input-sm campo-numerico", type = "text", inputmode = "decimal", value = String.Format(new System.Globalization.CultureInfo("es-Es"), "{0:N2}", Model.Detalles[i].Medida), placeholder = "0.00" })
                            </td>
                            <td style="width: 160px;">
                                @Html.DropDownListFor(m => m.Detalles[i].UnidadID, new SelectList(Model.Unidades, "Value", "Text", Model.Detalles[i].UnidadID), "-- Sin unidad --", new { @class = "form-control input-sm" })
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Detalles[i].Tipo, new { @class = "form-control input-sm" })
                            </td>
                            <td class="text-center" style="width: 80px;">
                                @Html.CheckBoxFor(m => m.Detalles[i].Eliminar)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

        



