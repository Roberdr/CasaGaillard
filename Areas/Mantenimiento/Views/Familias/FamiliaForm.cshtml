@model CasaGaillard.Models.ViewModels.FamiliaFormViewModel
@{ var editando = Model.FamiliaId > 0; ViewBag.Title = editando ? "Editar familia" : "Nueva familia"; }
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.FamiliaId) @Html.ValidationSummary(true, "", new { @class = "text-danger" })
<div class="form-group">@Html.LabelFor(m => m.Nombre)<div>@Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "150" })@Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })</div></div>
<div class="form-group">@Html.LabelFor(m => m.Descripcion)<div>@Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = "3", maxlength = "500" })@Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })</div></div>
<button type="submit" class="btn btn-primary">Guardar</button> @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" }) }
