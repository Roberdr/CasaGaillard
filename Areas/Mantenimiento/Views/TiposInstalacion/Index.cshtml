@model IEnumerable<CasaGaillard.Models.ViewModels.TipoInstalacionCatalogoViewModel>
@{ ViewBag.Title = "Tipos de instalación"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Tipos de instalación</h2>@Html.ActionLink("Nuevo tipo", "Create", null, new { @class = "btn btn-success" })</div>
@if (TempData["LoginMessage"] != null) { <div class="alert alert-success">@TempData["LoginMessage"]</div> }
<div class="table-responsive"><table class="table table-striped table-bordered">
<thead><tr><th>Nombre</th><th>Descripción</th><th>Instalaciones asociadas</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nombre</td><td>@item.Descripcion</td><td>@item.InstalacionesAsociadas</td><td class="text-nowrap">@Html.ActionLink("Editar", "Edit", new { id = item.Id }) | @Html.ActionLink("Eliminar", "Delete", new { id = item.Id })</td></tr> }
</tbody></table></div>
