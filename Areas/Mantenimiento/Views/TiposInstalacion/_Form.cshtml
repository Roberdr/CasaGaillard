@model CasaGaillard.Models.ViewModels.TipoInstalacionCatalogoViewModel
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
<div class="form-group">@Html.LabelFor(m => m.Nombre, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "100" })@Html.ValidationMessageFor(m => m.Nombre)</div></div>
<div class="form-group">@Html.LabelFor(m => m.Descripcion, new { @class = "control-label col-md-2" })<div class="col-md-10">@Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = "3", maxlength = "500" })@Html.ValidationMessageFor(m => m.Descripcion)</div></div>
