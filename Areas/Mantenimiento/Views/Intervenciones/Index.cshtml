@model IEnumerable<CasaGaillard.Models.ViewModels.IntervencionFilaViewModel>
@{ var tarea = ViewBag.Tarea as CasaGaillard.Models.TareaMantenimiento; var esGlobal = ViewBag.EsGlobal == true; ViewBag.Title = "Intervenciones"; }

@if (esGlobal)
{
    <h2>Intervenciones</h2>
    <p class="text-muted">Registro de intervenciones y repuestos utilizados en las tareas de mantenimiento.</p>
}
else
{
    <h2>Intervenciones de @tarea.Codigo</h2>
    <p class="text-muted">@tarea.Titulo</p>
}
<p>
    @if (esGlobal)
    { @Html.ActionLink("Ver tareas", "Index", "TareasMantenimiento", new { area = "Mantenimiento" }, new { @class = "btn btn-primary" }) }
    else
    { @Html.ActionLink("Volver a la tarea", "Details", "TareasMantenimiento", new { area = "Mantenimiento", id = tarea.ID }, new { @class = "btn btn-outline-primary" }) }
    @if (!esGlobal && (User.IsInRole(CasaGaillard.Models.AppRoles.Administrador) || User.IsInRole(CasaGaillard.Models.AppRoles.Mantenimiento)))
    { @Html.ActionLink("Registrar intervención", "Create", new { tareaId = tarea.ID }, new { @class = "btn btn-success" }) }
</p>
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead><tr>@if (esGlobal) { <th>Tarea</th> }<th>Inicio</th><th>Técnico</th><th>Descripción</th><th>Horas</th><th>Coste mano de obra</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @if (esGlobal) { <td>@Html.ActionLink(item.TareaCodigo + " - " + item.TareaTitulo, "Details", "TareasMantenimiento", new { area = "Mantenimiento", id = item.TareaMantenimientoId }, null)</td> }
                <td>@item.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Tecnico</td>
                <td>@item.Descripcion</td><td>@(item.HorasEmpleadas.HasValue ? item.HorasEmpleadas.Value.ToString("0.##") : "—")</td>
                <td>@(item.CosteManoObra.HasValue ? item.CosteManoObra.Value.ToString("C") : "—")</td>
                <td>@Html.ActionLink("Detalle y repuestos", "Details", new { id = item.Id })</td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="@(esGlobal ? 7 : 6)" class="text-muted">No hay intervenciones registradas.</td></tr> }
        </tbody>
    </table>
</div>
