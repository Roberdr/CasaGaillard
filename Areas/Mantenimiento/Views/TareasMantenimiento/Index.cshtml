@model IEnumerable<CasaGaillard.Models.ViewModels.TareaMantenimientoResumenViewModel>

@{
    ViewBag.Title = "Tareas de mantenimiento";
}

<div class="row">
    <div class="col-md-12">
        <h2>Tareas de mantenimiento</h2>
        <p class="text-muted">Registro de incidencias detectadas en vehículos, instalaciones y equipos.</p>
        <p>@Html.ActionLink("Nueva tarea", "Create", null, new { @class = "btn btn-primary" })</p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Título</th>
                    <th>Ubicación</th>
                    <th>Equipo</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Asignada a</th>
                    <th>Creada</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var tarea in Model)
                    {
                        <tr>
                            <td>@tarea.Codigo</td>
                            <td>@tarea.Titulo</td>
                            <td>@tarea.Ubicacion</td>
                            <td>@tarea.Equipo</td>
                            <td>@tarea.Prioridad</td>
                            <td>@tarea.Estado</td>
                            <td>@tarea.AsignadaA</td>
                            <td>@tarea.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-right">
                                @Html.ActionLink("Ver", "Details", new { id = tarea.ID }) |
                                @Html.ActionLink("Editar", "Edit", new { id = tarea.ID })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-muted">No hay tareas registradas todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
