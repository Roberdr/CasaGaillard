@model CasaGaillard.Models.ViewModels.TareaMantenimientoFormViewModel

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.InstalacionId)
            @Html.DropDownListFor(m => m.InstalacionId, Model.Instalaciones, "-- Sin instalación vinculada --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.InstalacionId)
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.EquipoId)
            @Html.DropDownListFor(m => m.EquipoId, Model.Equipos, "-- Sin equipo vinculado --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.EquipoId)
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.CubaId)
            @Html.DropDownListFor(m => m.CubaId, Model.Cubas, "-- Sin cisterna vinculada --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.CubaId)
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.GrupoId)
            @Html.DropDownListFor(m => m.GrupoId, Model.Grupos, "-- Sin grupo vinculado --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.GrupoId)
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.VehiculoId)
            @Html.DropDownListFor(m => m.VehiculoId, Model.Vehiculos, "-- Sin vehículo vinculado --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.VehiculoId)
        </div>
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(m => m.PlanMantenimientoId)
    @Html.DropDownListFor(m => m.PlanMantenimientoId, Model.PlanesMantenimiento, "-- Sin plan asociado --", new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.PlanMantenimientoId)
    <p class="help-block">Vincula la tarea a una instalación/equipo, una cisterna/grupo o un vehículo. Si eliges un grupo, se completará su cisterna.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.Titulo)
            @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Titulo)
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.Ubicacion, "Ubicación (texto histórico)")
            @Html.TextBoxFor(m => m.Ubicacion, new { @class = "form-control" })
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.Equipo, "Equipo (texto histórico)")
            @Html.TextBoxFor(m => m.Equipo, new { @class = "form-control" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.DetectadoPor)
            @Html.DropDownListFor(m => m.DetectadoPorPersonaID, Model.PersonasDetectadoPor, "-- Sin vincular --", new { @class = "form-control" })
            @Html.TextBoxFor(m => m.DetectadoPor, new { @class = "form-control", placeholder = "Se completará al seleccionar una persona", @readonly = "readonly" })
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.Contacto)
            @Html.DropDownListFor(m => m.ContactoPersonaID, Model.PersonasContacto, "-- Sin vincular --", new { @class = "form-control" })
            @Html.TextBoxFor(m => m.Contacto, new { @class = "form-control", placeholder = "Se completará al seleccionar una persona", @readonly = "readonly" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(m => m.AsignadaA)
            @Html.DropDownListFor(m => m.AsignadaAPersonaID, Model.PersonasAsignadaA, "-- Sin asignar --", new { @class = "form-control" })
            @Html.TextBoxFor(m => m.AsignadaA, new { @class = "form-control", placeholder = "Se completará al seleccionar una persona", @readonly = "readonly" })
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.Prioridad)
            @Html.DropDownListFor(m => m.Prioridad, Model.Prioridades, new { @class = "form-control" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.Estado)
            @Html.DropDownListFor(m => m.Estado, Model.Estados, new { @class = "form-control" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(m => m.EmpresaExterior)
            @Html.DropDownListFor(m => m.EmpresaExteriorEntidadID, Model.Entidades, "-- Sin vincular --", new { @class = "form-control" })
            @Html.TextBoxFor(m => m.EmpresaExterior, new { @class = "form-control", placeholder = "Se completará al seleccionar una entidad", @readonly = "readonly" })
        </div>
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(m => m.Descripcion)
    @Html.TextAreaFor(m => m.Descripcion, 5, 20, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Descripcion)
</div>

<div class="form-group">
    @Html.LabelFor(m => m.AccionesARealizar)
    @Html.TextAreaFor(m => m.AccionesARealizar, 4, 20, new { @class = "form-control" })
</div>

<div class="form-group">
    @Html.LabelFor(m => m.AccesoriosSeleccionados)
    @Html.ListBoxFor(m => m.AccesoriosSeleccionados, Model.Accesorios, new { @class = "form-control", size = "8" })
    <p class="help-block">Mantén pulsada la tecla Ctrl para seleccionar varios accesorios.</p>
</div>

<div class="form-group">
    @Html.LabelFor(m => m.Observaciones)
    @Html.TextAreaFor(m => m.Observaciones, 4, 20, new { @class = "form-control" })
</div>

<div class="form-group">
    @Html.LabelFor(m => m.FotosAdjuntas)
    <input type="file" name="FotosAdjuntas" class="form-control" accept="image/*" multiple="multiple" />
    <p class="help-block">Puedes adjuntar varias fotos para mostrar la avería o detalles de la tarea.</p>
</div>
