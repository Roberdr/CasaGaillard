@model CasaGaillard.Models.ViewModels.TareaMantenimientoGestionViewModel

@{
    ViewBag.Title = "Gestionar tarea";
}

<h2>Gestionar tarea de mantenimiento</h2>

<div class="row">
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading"><strong>@Model.Codigo</strong></div>
            <div class="panel-body">
                <dl class="dl-horizontal">
                    <dt>Título</dt>
                    <dd>@Model.Titulo</dd>
                    <dt>Ubicación</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Ubicacion) ? "Sin indicar" : Model.Ubicacion)</dd>
                    <dt>Equipo</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Equipo) ? "Sin indicar" : Model.Equipo)</dd>
                    <dt>Detectado por</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.DetectadoPor) ? "Sin indicar" : Model.DetectadoPor)</dd>
                    <dt>Contacto</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Contacto) ? "Sin indicar" : Model.Contacto)</dd>
                </dl>
                <p style="white-space: pre-wrap;">@Model.Descripcion</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ID)
            @Html.HiddenFor(m => m.Codigo)
            @Html.ValidationSummary(true)

            <div class="panel panel-default">
                <div class="panel-heading"><strong>Gestión rápida</strong></div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Prioridad)
                                @Html.DropDownListFor(m => m.Prioridad, Model.Prioridades, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Estado)
                                @Html.DropDownListFor(m => m.Estado, Model.Estados, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(m => m.AsignadaA)
                                @Html.DropDownListFor(m => m.AsignadaAPersonaID, Model.PersonasAsignadaA, "-- Sin asignar --", new { @class = "form-control" })
                                @Html.TextBoxFor(m => m.AsignadaA, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.EmpresaExterior)
                        @Html.DropDownListFor(m => m.EmpresaExteriorEntidadID, Model.Entidades, "-- Sin vincular --", new { @class = "form-control" })
                        @Html.TextBoxFor(m => m.EmpresaExterior, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.AccionesARealizar)
                        @Html.TextAreaFor(m => m.AccionesARealizar, 4, 20, new { @class = "form-control" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.AccesoriosSeleccionados)
                        @Html.ListBoxFor(m => m.AccesoriosSeleccionados, Model.Accesorios, new { @class = "form-control", size = "8" })
                        <p class="help-block">Mantén pulsada la tecla Ctrl para seleccionar varios accesorios.</p>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Observaciones)
                        @Html.TextAreaFor(m => m.Observaciones, 4, 20, new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar gestión" class="btn btn-primary" />
                @Html.ActionLink("Volver", "Details", new { id = Model.ID }, new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
