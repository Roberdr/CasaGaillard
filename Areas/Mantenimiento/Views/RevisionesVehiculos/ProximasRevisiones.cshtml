@model IEnumerable<CasaGaillard.Models.ViewModels.ProximaRevisionVehiculoViewModel>

@{
    ViewBag.Title = "Próximas Revisiones";
}

<h2>Próximas Revisiones</h2>

<div class="container">

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Matrícula</th>
                <th>Tipo Revisión</th>
                <th>Fecha de Caducidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr>

                    <td>@g.MatriculaVehiculo</td>
                    <td>@g.TipoRevision</td>
                    <td>@(g.Caducidad.HasValue ? g.Caducidad.Value.ToString("d") : "")</td>

                </tr>
            }

        </tbody>
    </table>
</div>

