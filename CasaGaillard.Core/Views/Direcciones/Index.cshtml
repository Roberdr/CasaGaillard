@model IReadOnlyList<DireccionRow>
@{ ViewData["Title"] = "Direcciones"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Direcciones</h1>@if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento")) { <a asp-action="Create" class="btn btn-primary">Nueva dirección</a> }</div>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Dirección</th><th>Población</th><th>Código postal</th><th></th></tr></thead><tbody>
@foreach (var row in Model) { <tr><td>@row.TipoVia @row.NombreVia @row.Numero</td><td>@row.Poblacion</td><td>@row.CodigoPostal</td><td class="text-end"><a asp-action="Details" asp-route-id="@row.Id">Ver</a>@if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento")) { <text> · </text><a asp-action="Edit" asp-route-id="@row.Id">Editar</a><text> · </text><a asp-action="Delete" asp-route-id="@row.Id">Eliminar</a> }</td></tr> }
</tbody></table></div>
