<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CasaGaillard.Core</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CasaGaillard.Core.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl bg-body-tertiary border-bottom shadow-sm sticky-top mb-4" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">Casa Gaillard</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavigation">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="Vehiculos" asp-action="Index">Vehículos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="Intervenciones" asp-action="Index">Intervenciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="TareasMantenimiento" asp-action="Index">Tareas de mantenimiento</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="Instalaciones" asp-action="Index">Instalaciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="Equipos" asp-action="Index">Equipos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="PlanesMantenimiento" asp-action="Index">Planes de mantenimiento</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="CostesMantenimiento" asp-action="Index">Historial y costes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="Mantenimiento" asp-controller="Revisiones" asp-action="Index">Revisiones de cubas</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="nav-link text-white-50">@User.Identity.Name</span></li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link link-light text-decoration-none">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4 app-main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-body-secondary">
        <div class="container">
        &copy; 2026 - Casa Gaillard
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
