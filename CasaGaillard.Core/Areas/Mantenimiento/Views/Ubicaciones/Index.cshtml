@model IEnumerable<UbicacionCatalogoViewModel>
@{ ViewData["Title"] = "Ubicaciones"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ubicaciones</h1>
    <a asp-action="Create" class="btn btn-success">Nueva ubicación</a>
</div>
@if (TempData["LoginMessage"] is string message) { <div class="alert alert-success">@message</div> }
<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead><tr><th>Código</th><th>Nombre</th><th>Descripción</th><th>Instalaciones</th><th>Accesorios</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td><td>@item.Nombre</td><td>@item.Descripcion</td>
                <td>@item.InstalacionesAsociadas</td><td>@item.AccesoriosAsociados</td>
                <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.UbicacionId">Editar</a> | <a asp-action="Delete" asp-route-id="@item.UbicacionId">Eliminar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
