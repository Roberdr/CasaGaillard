@model RevisionDetalleViewModel
@{ViewData["Title"]="Detalle de revisión";}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1 class="mb-0">Detalle de revisión</h1><div><a asp-action="Index" asp-route-cubaId="@Model.CubaId" class="btn btn-outline-secondary">Volver</a>@if(User.IsInRole("Administrador")||User.IsInRole("Mantenimiento")){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary ms-1">Editar</a>}</div></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-body"><h2 class="h5 mb-0">Cuba @Model.MatriculaCuba</h2></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Fecha de revisión</dt><dd class="col-sm-9">@Model.FechaRevision.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@(Model.Descripcion??"—")</dd><dt class="col-sm-3">Válida hasta</dt><dd class="col-sm-9">@Model.ValidaHasta?.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Descripción próxima</dt><dd class="col-sm-9">@(Model.DescripcionProxima??"—")</dd><dt class="col-sm-3">Autorizado</dt><dd class="col-sm-9">@(Model.Autorizado??"—")</dd></dl></div></div>
