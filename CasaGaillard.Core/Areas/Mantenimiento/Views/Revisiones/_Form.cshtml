@model RevisionFormViewModel
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="CubaId" class="form-label"></label><select asp-for="CubaId" asp-items="Model.Cubas" class="form-select"><option value="">Selecciona cuba...</option></select><span asp-validation-for="CubaId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="FechaRevision" class="form-label"></label><input asp-for="FechaRevision" type="date" class="form-control"/><span asp-validation-for="FechaRevision" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" rows="4" class="form-control"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ValidaHasta" class="form-label"></label><input asp-for="ValidaHasta" type="date" class="form-control"/><span asp-validation-for="ValidaHasta" class="text-danger"></span><div class="form-text">Si se deja vacío, se establecerá una validez de 30 meses desde la fecha de revisión.</div></div>
<div class="mb-3"><label asp-for="DescripcionProxima" class="form-label"></label><textarea asp-for="DescripcionProxima" rows="3" class="form-control"></textarea><span asp-validation-for="DescripcionProxima" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="AutorizadoPersonasEntidadId" class="form-label"></label><select asp-for="AutorizadoPersonasEntidadId" asp-items="Model.PersonasEntidad" class="form-select"><option value="">Selecciona persona y entidad...</option></select><span asp-validation-for="AutorizadoPersonasEntidadId" class="text-danger"></span><div class="form-text">La etiqueta del autorizante se genera a partir de la persona y la entidad.</div>@if(!string.IsNullOrWhiteSpace(Model.Autorizado)){<div class="small text-body-secondary mt-1">Etiqueta actual: @Model.Autorizado</div>}</div>
