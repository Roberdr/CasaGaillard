@model CasaGaillard.Core.Models.IntervencionViewModel

@{
    ViewData["Title"] = "Detalle Intervención";
}

<h1>Detalle</h1>

<div>
    <h4>Intervención</h4>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Model.Titulo</dd>
        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>
    </dl>
</div>

<p>
    <a asp-area="Mantenimiento" asp-controller="Intervenciones" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-area="Mantenimiento" asp-controller="Intervenciones" asp-action="Index">Volver al listado</a>
</p>
