@model IntervencionDetailsViewModel
@{
    ViewData["Title"] = "Detalle de intervención";
}

<h1>Intervención de @Model.TareaCodigo</h1>
@if (TempData["LoginMessage"] is string message)
{
    <div class="alert alert-info">@message</div>
}
<p>
    <a asp-action="Index" asp-route-tareaId="@Model.TareaMantenimientoId" class="btn btn-outline-secondary">Volver a las intervenciones</a>
    @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar intervención</a>
    }
</p>
<div class="card mb-4">
    <div class="card-header"><strong>@Model.FechaInicio.ToString("dd/MM/yyyy HH:mm") — @Model.Tecnico</strong></div>
    <div class="card-body">
        <p style="white-space: pre-wrap">@Model.Descripcion</p>
        <p><strong>Fin:</strong> @(Model.FechaFin?.ToString("dd/MM/yyyy HH:mm") ?? "Sin indicar")
            <strong>Horas:</strong> @(Model.HorasEmpleadas?.ToString("0.##") ?? "—")
            <strong>Mano de obra:</strong> @(Model.CosteManoObra?.ToString("C") ?? "—")</p>
    </div>
</div>

<h2>Repuestos utilizados</h2>
<div class="table-responsive"><table class="table table-striped table-bordered">
    <thead><tr><th>Repuesto</th><th>Cantidad</th><th>Coste unitario</th><th>Observaciones</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Repuestos)
    {
        <tr><td>@item.AccesorioNombre</td><td>@item.Cantidad</td><td>@(item.CosteUnitario?.ToString("C") ?? "—")</td><td>@item.Observaciones</td><td>
            @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
            {
                <form asp-action="RemoveRepuesto" method="post">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-link">Quitar</button>
                </form>
            }
        </td></tr>
    }
    @if (Model.Repuestos.Count == 0)
    {
        <tr><td colspan="5" class="text-center text-body-secondary">No hay repuestos asociados.</td></tr>
    }
    </tbody></table></div>

@if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
{
    <h3>Añadir repuesto consumido</h3>
    <div class="card mb-3"><div class="card-header">¿No aparece el repuesto? Créalo aquí rápidamente</div><div class="card-body">
        <form asp-action="CrearRepuestoRapido" method="post" class="row g-3">
            <input type="hidden" name="IntervencionId" value="@Model.Id" />
            <div class="col-md-4"><label for="Nombre" class="form-label">Nombre</label><input id="Nombre" name="Nombre" maxlength="150" required class="form-control" /></div>
            <div class="col-md-4"><label for="TipoAccesorioId" class="form-label">Tipo</label><select id="TipoAccesorioId" name="TipoAccesorioId" asp-items="Model.TiposAccesorio" required class="form-select"><option value="">Selecciona un tipo...</option></select></div>
            <div class="col-md-4" data-material-rapido data-url="@Url.Action("Crear", "Materiales", new { area = "Mantenimiento" })"><label for="MaterialId" class="form-label">Material</label><select id="MaterialId" name="MaterialId" asp-items="Model.Materiales" required class="form-select"><option value="">Selecciona un material...</option></select><div class="input-group input-group-sm mt-2"><input data-material-nombre class="form-control" maxlength="150" placeholder="Nuevo material" aria-label="Nombre del nuevo material"/><button type="button" data-material-crear class="btn btn-outline-secondary">Crear y seleccionar</button></div>@Html.AntiForgeryToken()<small data-material-estado class="form-text" role="status"></small></div>
            <div class="col-12"><button type="submit" class="btn btn-outline-primary">Crear y seleccionar</button></div>
        </form>
    </div></div>
    <form asp-action="AddRepuesto" method="post" class="col-lg-6">
        <input asp-for="RepuestoForm.IntervencionId" type="hidden" />
        <div class="mb-3"><label asp-for="RepuestoForm.AccesorioId" class="form-label"></label><select asp-for="RepuestoForm.AccesorioId" asp-items="Model.RepuestoForm.Accesorios" class="form-select"><option value="">Selecciona un repuesto...</option></select></div>
        <div class="mb-3"><label asp-for="RepuestoForm.Cantidad" class="form-label"></label><input asp-for="RepuestoForm.Cantidad" type="number" min="0.001" step="0.001" class="form-control" /></div>
        <div class="mb-3"><label asp-for="RepuestoForm.CosteUnitario" class="form-label"></label><input asp-for="RepuestoForm.CosteUnitario" type="number" min="0" step="0.01" class="form-control" /></div>
        <div class="mb-3"><label asp-for="RepuestoForm.Observaciones" class="form-label"></label><input asp-for="RepuestoForm.Observaciones" class="form-control" /></div>
        <button type="submit" class="btn btn-primary">Añadir repuesto</button>
    </form>
}
<script src="~/js/material-rapido.js" asp-append-version="true"></script>
