@model IReadOnlyList<InstalacionFilaViewModel>
@{
    ViewData["Title"] = "Instalaciones";
    var incluirBajas = ViewData["IncluirBajas"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Instalaciones</h1>
    @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
    {
        <a asp-action="Create" class="btn btn-success">Nueva instalación</a>
    }
</div>
@if (TempData["LoginMessage"] is string message) { <div class="alert alert-info">@message</div> }
<p>
    @if (incluirBajas) { <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Ocultar fuera de servicio</a> }
    else { <a asp-action="Index" asp-route-incluirBajas="true" class="btn btn-outline-secondary btn-sm">Mostrar fuera de servicio</a> }
</p>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Ubicación</th><th>Estado</th><th>Criticidad</th><th>Equipos</th><th></th></tr></thead>
        <tbody>
        @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-body-secondary">No hay instalaciones.</td></tr> }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td><td>@item.Nombre</td><td>@(item.TipoNombre ?? "Sin tipo")</td><td>@(item.UbicacionNombre ?? "Sin ubicación")</td>
                <td>@item.Estado</td><td>@item.Criticidad / 5</td>
                <td>@item.NumeroEquipos</td>
                <td class="text-nowrap">
                    <a asp-area="Mantenimiento" asp-controller="InstalacionDocumentos" asp-action="Index" asp-route-instalacionId="@item.Id">Documentos</a>
                    <a asp-area="Mantenimiento" asp-controller="FotosActivos" asp-action="Index" asp-route-tipo="Instalacion" asp-route-id="@item.Id">Fotos</a>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        @if (item.Estado != "FUERA_SERVICIO")
                        {
                            <form asp-action="DarDeBaja" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link" onclick="return confirm('¿Marcar esta instalación fuera de servicio?');">Dar de baja</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
