@model InstalacionFormViewModel
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row">
    <div class="col-md-4 mb-3"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" class="form-control" /><span asp-validation-for="Codigo" class="text-danger"></span></div>
    <div class="col-md-8 mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
</div>
<div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" rows="3" class="form-control"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<div class="row">
    <div class="col-md-4 mb-3"><label asp-for="TipoInstalacionId" class="form-label"></label><select asp-for="TipoInstalacionId" asp-items="Model.Tipos" class="form-select"><option value="">Sin tipo</option></select></div>
    <div class="col-md-4 mb-3"><label asp-for="UbicacionId" class="form-label"></label><select asp-for="UbicacionId" asp-items="Model.Ubicaciones" class="form-select"><option value="">Sin ubicación</option></select></div>
    <div class="col-md-4 mb-3"><label asp-for="ResponsablePersonaId" class="form-label"></label><select asp-for="ResponsablePersonaId" asp-items="Model.Responsables" class="form-select"><option value="">Sin responsable</option></select></div>
</div>
<div class="row">
    <div class="col-md-4 mb-3"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select"><option>ACTIVA</option><option>PARADA</option><option>MANTENIMIENTO</option><option>FUERA_SERVICIO</option></select><span asp-validation-for="Estado" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><label asp-for="Criticidad" class="form-label"></label><input asp-for="Criticidad" type="number" min="1" max="5" class="form-control" /><span asp-validation-for="Criticidad" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><label asp-for="CodigoPlano" class="form-label"></label><input asp-for="CodigoPlano" class="form-control" /><span asp-validation-for="CodigoPlano" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="FechaPuestaMarcha" class="form-label"></label><input asp-for="FechaPuestaMarcha" type="date" class="form-control" /></div>
    <div class="col-md-6 mb-3"><label asp-for="FechaBaja" class="form-label"></label><input asp-for="FechaBaja" type="date" class="form-control" /><span asp-validation-for="FechaBaja" class="text-danger"></span></div>
</div>
<div class="form-check mb-2"><input asp-for="CriticaProduccion" class="form-check-input" /><label asp-for="CriticaProduccion" class="form-check-label"></label></div>
<div class="form-check mb-3"><input asp-for="CriticaSeguridad" class="form-check-input" /><label asp-for="CriticaSeguridad" class="form-check-label"></label></div>
<div class="mb-3"><label asp-for="Observaciones" class="form-label"></label><textarea asp-for="Observaciones" rows="3" class="form-control"></textarea><span asp-validation-for="Observaciones" class="text-danger"></span></div>
