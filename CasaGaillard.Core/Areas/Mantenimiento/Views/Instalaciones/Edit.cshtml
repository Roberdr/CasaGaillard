@model InstalacionFormViewModel
@{ ViewData["Title"] = "Editar instalación"; }
<h1>Editar instalación</h1>
<form asp-action="Edit" method="post" class="col-lg-9">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</form>
