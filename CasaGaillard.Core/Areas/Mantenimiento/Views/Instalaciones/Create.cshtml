@model InstalacionFormViewModel
@{ ViewData["Title"] = "Nueva instalación"; }
<h1>Nueva instalación</h1>
<form asp-action="Create" method="post" class="col-lg-9">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-success">Crear</button>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</form>
