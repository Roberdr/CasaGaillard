@model GrupoFilaViewModel
@{ ViewData["Title"]="Eliminar grupo"; }
<h1>Eliminar grupo</h1><p>¿Quieres eliminar este grupo y sus relaciones con accesorios?</p><dl class="row"><dt class="col-sm-3">Cuba</dt><dd class="col-sm-9">@Model.Cuba</dd><dt class="col-sm-3">Compartimento</dt><dd class="col-sm-9">@Model.Compartimento</dd><dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Tipo</dd><dt class="col-sm-3">Situación</dt><dd class="col-sm-9">@Model.Situacion</dd></dl><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form>
