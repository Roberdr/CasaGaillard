@model CostesMantenimientoViewModel
@using System.Globalization
@{ ViewData["Title"]="Historial y costes de mantenimiento";var totalIntervenciones=Model.Resumen.Sum(x=>x.NumeroIntervenciones);var totalHoras=Model.Resumen.Sum(x=>x.HorasEmpleadas);var totalManoObra=Model.Resumen.Sum(x=>x.CosteManoObra);var totalRepuestos=Model.Resumen.Sum(x=>x.CosteRepuestos);var sinCoste=Model.Resumen.Sum(x=>x.RepuestosSinCoste);var total=Model.Resumen.Sum(x=>x.CosteTotal);var maxMes=Model.CostePorMes.Count==0?1m:Math.Max(1m,Model.CostePorMes.Max(x=>x.Total));var maxInstalacion=Model.CostePorInstalacion.Count==0?1m:Math.Max(1m,Model.CostePorInstalacion.Max(x=>x.Total));var maxEquipo=Model.CostePorEquipo.Count==0?1m:Math.Max(1m,Model.CostePorEquipo.Max(x=>x.Total)); }
<h1>Historial y costes de mantenimiento</h1>
<form asp-action="Index" method="get" class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="row g-3">
    <div class="col-md-3"><label asp-for="FechaDesde" class="form-label"></label><input asp-for="FechaDesde" type="date" class="form-control"/></div>
    <div class="col-md-3"><label asp-for="FechaHasta" class="form-label"></label><input asp-for="FechaHasta" type="date" class="form-control"/><span asp-validation-for="FechaHasta" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="InstalacionId" class="form-label"></label><select asp-for="InstalacionId" asp-items="Model.Instalaciones" class="form-select"><option value="">Todas las instalaciones</option></select></div>
    <div class="col-md-3"><label asp-for="EquipoId" class="form-label"></label><select asp-for="EquipoId" asp-items="Model.Equipos" class="form-select"><option value="">Todos los equipos</option></select></div>
    <div class="col-12"><div asp-validation-summary="ModelOnly" class="text-danger"></div><button class="btn btn-primary" type="submit">Aplicar filtros</button> <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a> <a asp-action="Exportar" asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")" asp-route-instalacionId="@Model.InstalacionId" asp-route-equipoId="@Model.EquipoId" class="btn btn-outline-success">Exportar a Excel (CSV)</a></div>
</div></div></form>
<h2>Distribución de costes</h2>
<div class="row g-3 mb-4">
    <div class="col-lg-4"><section class="card h-100 border-0 shadow-sm"><div class="card-body"><h3 class="h5">Por mes</h3>
        @if(Model.CostePorMes.Count==0){<p class="text-body-secondary mb-0">Sin datos para mostrar.</p>}
        else{<ul class="list-unstyled mb-0">@foreach(var item in Model.CostePorMes){<li class="mb-3"><div class="d-flex justify-content-between gap-2 small"><span>@item.Etiqueta</span><strong>@item.Total.ToString("C",CultureInfo.CurrentCulture)</strong></div><div class="progress" role="img" aria-label="@item.Etiqueta: @item.Total.ToString("C",CultureInfo.CurrentCulture)"><div class="progress-bar" style="width: @((item.Total/maxMes*100).ToString("0.#",CultureInfo.InvariantCulture))%"></div></div></li>}</ul>}
    </div></section></div>
    <div class="col-lg-4"><section class="card h-100 border-0 shadow-sm"><div class="card-body"><h3 class="h5">Por instalación · principales 8</h3>
        @if(Model.CostePorInstalacion.Count==0){<p class="text-body-secondary mb-0">Sin datos para mostrar.</p>}
        else{<ul class="list-unstyled mb-0">@foreach(var item in Model.CostePorInstalacion){<li class="mb-3"><div class="d-flex justify-content-between gap-2 small"><span class="text-truncate">@item.Etiqueta</span><strong class="text-nowrap">@item.Total.ToString("C",CultureInfo.CurrentCulture)</strong></div><div class="progress" role="img" aria-label="@item.Etiqueta: @item.Total.ToString("C",CultureInfo.CurrentCulture)"><div class="progress-bar bg-success" style="width: @((item.Total/maxInstalacion*100).ToString("0.#",CultureInfo.InvariantCulture))%"></div></div></li>}</ul>}
    </div></section></div>
    <div class="col-lg-4"><section class="card h-100 border-0 shadow-sm"><div class="card-body"><h3 class="h5">Por equipo · principales 8</h3>
        @if(Model.CostePorEquipo.Count==0){<p class="text-body-secondary mb-0">Sin datos para mostrar.</p>}
        else{<ul class="list-unstyled mb-0">@foreach(var item in Model.CostePorEquipo){<li class="mb-3"><div class="d-flex justify-content-between gap-2 small"><span class="text-truncate">@item.Etiqueta</span><strong class="text-nowrap">@item.Total.ToString("C",CultureInfo.CurrentCulture)</strong></div><div class="progress" role="img" aria-label="@item.Etiqueta: @item.Total.ToString("C",CultureInfo.CurrentCulture)"><div class="progress-bar bg-warning" style="width: @((item.Total/maxEquipo*100).ToString("0.#",CultureInfo.InvariantCulture))%"></div></div></li>}</ul>}
    </div></section></div>
</div>
<h2>Resumen por instalación y equipo</h2>
@if(Model.Resumen.Count>0){<div class="card border-0 shadow-sm mb-4"><div class="card-body p-0"><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead class="table-light"><tr><th>Instalación</th><th>Equipo</th><th>Intervenciones</th><th>Horas</th><th>Mano de obra</th><th>Repuestos</th><th>Líneas sin coste</th><th>Total</th></tr></thead><tbody>
@foreach(var item in Model.Resumen){<tr><td>@(string.IsNullOrWhiteSpace(item.InstalacionCodigo)?item.InstalacionNombre:$"{item.InstalacionCodigo} - {item.InstalacionNombre}")</td><td>@(string.IsNullOrWhiteSpace(item.EquipoCodigo)?item.EquipoNombre:$"{item.EquipoCodigo} - {item.EquipoNombre}")</td><td>@item.NumeroIntervenciones</td><td>@item.HorasEmpleadas.ToString("0.##")</td><td>@item.CosteManoObra.ToString("C",CultureInfo.CurrentCulture)</td><td>@item.CosteRepuestos.ToString("C",CultureInfo.CurrentCulture)</td><td>@item.RepuestosSinCoste</td><td><strong>@item.CosteTotal.ToString("C",CultureInfo.CurrentCulture)</strong></td></tr>}
</tbody><tfoot class="table-group-divider"><tr><th colspan="2">Total filtrado</th><th>@totalIntervenciones</th><th>@totalHoras.ToString("0.##")</th><th>@totalManoObra.ToString("C",CultureInfo.CurrentCulture)</th><th>@totalRepuestos.ToString("C",CultureInfo.CurrentCulture)</th><th>@sinCoste</th><th>@total.ToString("C",CultureInfo.CurrentCulture)</th></tr></tfoot></table></div></div></div>
@if(sinCoste>0){<p class="text-warning">Hay @sinCoste líneas de repuesto sin coste unitario; no se incluyen en los importes.</p>}}
else{<p class="text-body-secondary">No hay intervenciones para los filtros seleccionados.</p>}
<h2>Detalle de intervenciones</h2>
@if(Model.Intervenciones.Count>0){<div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead class="table-light"><tr><th>Fecha</th><th>Tarea</th><th>Instalación / equipo</th><th>Técnico</th><th>Horas</th><th>Mano de obra</th><th>Repuestos</th><th>Sin coste</th><th>Total</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Intervenciones){<tr><td>@item.FechaInicio.ToString("dd/MM/yyyy")</td><td><a asp-area="Mantenimiento" asp-controller="TareasMantenimiento" asp-action="Details" asp-route-id="@item.TareaMantenimientoId">@item.TareaCodigo - @item.TareaTitulo</a></td><td>@item.InstalacionNombre<br/><small>@item.EquipoCodigo @item.EquipoNombre</small></td><td>@item.Tecnico</td><td>@(item.HorasEmpleadas?.ToString("0.##")??"—")</td><td>@item.CosteManoObra.ToString("C",CultureInfo.CurrentCulture)</td><td>@item.CosteRepuestos.ToString("C",CultureInfo.CurrentCulture)</td><td>@item.RepuestosSinCoste</td><td><strong>@item.CosteTotal.ToString("C",CultureInfo.CurrentCulture)</strong></td><td><a asp-area="Mantenimiento" asp-controller="Intervenciones" asp-action="Details" asp-route-id="@item.Id">Ver</a></td></tr>}
</tbody></table></div></div></div>}
else{<p class="text-body-secondary">No hay intervenciones para los filtros seleccionados.</p>}
