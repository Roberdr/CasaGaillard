@model PlanMantenimientoFormViewModel
<input asp-for="PlanId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row mb-3"><label asp-for="Nombre" class="col-md-2 col-form-label">Nombre del plan</label><div class="col-md-10"><input asp-for="Nombre" maxlength="150" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="EquipoId" class="col-md-2 col-form-label">Equipo</label><div class="col-md-10"><select asp-for="EquipoId" asp-items="Model.Equipos" class="form-select"><option value="">Sin equipo (plan de accesorio)</option></select><span asp-validation-for="EquipoId" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="AccesorioId" class="col-md-2 col-form-label">Accesorio</label><div class="col-md-10"><select asp-for="AccesorioId" asp-items="Model.Accesorios" class="form-select"><option value="">Sin accesorio (plan de equipo)</option></select><span asp-validation-for="AccesorioId" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="Tipo" class="col-md-2 col-form-label">Tipo</label><div class="col-md-10"><select asp-for="Tipo" class="form-select"><option value="">Selecciona tipo</option>@foreach(var tipo in new[]{"Preventivo","Predictivo","Legal","Limpieza","Calibración","Otro"}){<option value="@tipo">@tipo</option>}</select></div></div>
<div class="row mb-3"><label asp-for="Descripcion" class="col-md-2 col-form-label">Descripción</label><div class="col-md-10"><textarea asp-for="Descripcion" rows="3" maxlength="1000" class="form-control"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="Activo" class="col-md-2 col-form-label">Plan activo</label><div class="col-md-10 d-flex align-items-center"><input asp-for="Activo" class="form-check-input" /></div></div>
<div class="row mb-3"><label asp-for="FrecuenciaValor" class="col-md-2 col-form-label">Frecuencia</label><div class="col-md-4"><input asp-for="FrecuenciaValor" type="number" min="1" class="form-control" /><span asp-validation-for="FrecuenciaValor" class="text-danger"></span></div><div class="col-md-4"><select asp-for="FrecuenciaUnidad" class="form-select"><option value="">Unidad</option>@foreach(var unidad in new[]{"Días","Semanas","Meses","Años","Horas de uso"}){<option value="@unidad">@unidad</option>}</select><span asp-validation-for="FrecuenciaUnidad" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="AccesorioGrupoID" class="col-md-2 col-form-label">Ubicación / grupo</label><div class="col-md-10"><select asp-for="AccesorioGrupoID" asp-items="Model.GruposAccesorio" class="form-select"><option value="">Sin grupo asignado</option></select><span asp-validation-for="AccesorioGrupoID" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="PeriodicidadDias" class="col-md-2 col-form-label">Periodicidad (días)</label><div class="col-md-10"><input asp-for="PeriodicidadDias" type="number" min="1" class="form-control" /><span asp-validation-for="PeriodicidadDias" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="UltimaEjecucion" class="col-md-2 col-form-label">Última ejecución</label><div class="col-md-10"><input asp-for="UltimaEjecucion" type="date" class="form-control" /><span asp-validation-for="UltimaEjecucion" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="ProximaEjecucion" class="col-md-2 col-form-label">Próxima ejecución</label><div class="col-md-10"><input asp-for="ProximaEjecucion" type="date" class="form-control" /><span asp-validation-for="ProximaEjecucion" class="text-danger"></span></div></div>
<div class="row mb-3"><label asp-for="DuracionEstimadaMinutos" class="col-md-2 col-form-label">Duración estimada (minutos)</label><div class="col-md-10"><input asp-for="DuracionEstimadaMinutos" type="number" min="0" class="form-control" /><span asp-validation-for="DuracionEstimadaMinutos" class="text-danger"></span></div></div>
