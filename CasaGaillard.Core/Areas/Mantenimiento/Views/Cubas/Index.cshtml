@model IReadOnlyList<CubaFilaViewModel>
@{ ViewData["Title"]="Cubas";var incluirBajas=(bool)(ViewData["IncluirBajas"]??false); }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Cubas</h1><div class="d-flex gap-2"><a asp-action="Index" asp-route-incluirBajas="@(!incluirBajas)" class="btn btn-outline-secondary">@(incluirBajas?"Ocultar bajas":"Ver bajas")</a>@if(User.IsInRole("Administrador")||User.IsInRole("Mantenimiento")){<a asp-action="Create" class="btn btn-success">Crear cuba</a>}</div></div>
<div class="table-responsive"><table class="table table-sm table-striped table-hover"><thead><tr><th>Matrícula</th><th>Núm. cuadro</th><th>Código</th><th>Vehículo</th><th>Material</th><th>Peso bruto</th><th>Tara</th><th>Peso máximo</th><th>Actualizada</th>@if(incluirBajas){<th>Estado</th>}<th></th></tr></thead><tbody>
@if(Model.Count==0){<tr><td colspan="@(incluirBajas?11:10)" class="text-center text-body-secondary">No hay cubas registradas.</td></tr>}
@foreach(var cuba in Model){<tr><td>@cuba.Matricula</td><td>@cuba.NumCuadro</td><td>@cuba.Codigo</td><td>@cuba.Vehiculo</td><td>@cuba.Material</td><td>@cuba.PesoBruto</td><td>@cuba.Tara</td><td>@cuba.PesoMaxProducto</td><td>@cuba.UpdatedAt?.ToString("g")</td>@if(incluirBajas){<td>@(cuba.Baja?"Baja":"Activa")</td>}<td class="text-nowrap"><a asp-action="Details" asp-route-id="@cuba.Id">Detalle</a> · <a asp-area="Mantenimiento" asp-controller="Revisiones" asp-action="Index" asp-route-cubaId="@cuba.Id">Revisiones</a>@if(User.IsInRole("Administrador")||User.IsInRole("Mantenimiento")){<text> · </text><a asp-action="Edit" asp-route-id="@cuba.Id">Editar</a><text> · </text><a asp-action="Delete" asp-route-id="@cuba.Id">Eliminar</a>}</td></tr>}
</tbody></table></div>
