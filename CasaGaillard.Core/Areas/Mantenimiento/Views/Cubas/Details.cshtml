@model CubaDetalleViewModel
@{ ViewData["Title"]="Detalle de cuba"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Cuba @Model.Matricula</h1><div class="d-flex gap-2"><a asp-area="Mantenimiento" asp-controller="FotosActivos" asp-action="Index" asp-route-tipo="Cuba" asp-route-id="@Model.Id" class="btn btn-outline-primary">Gestionar fotos</a><a asp-area="Mantenimiento" asp-controller="Revisiones" asp-action="Index" asp-route-cubaId="@Model.Id" class="btn btn-outline-primary">Ver revisiones</a></div></div>
<h2 class="h4">Identificación</h2><dl class="row"><dt class="col-sm-4">Matrícula</dt><dd class="col-sm-8">@Model.Matricula</dd><dt class="col-sm-4">Núm. cuadro</dt><dd class="col-sm-8">@Model.NumCuadro</dd><dt class="col-sm-4">Código</dt><dd class="col-sm-8">@Model.Codigo</dd><dt class="col-sm-4">Constructor</dt><dd class="col-sm-8">@Model.Constructor</dd><dt class="col-sm-4">Número de fabricación</dt><dd class="col-sm-8">@Model.NumFabricacion</dd><dt class="col-sm-4">Homologación</dt><dd class="col-sm-8">@Model.NumHomologacion</dd><dt class="col-sm-4">Fecha de construcción</dt><dd class="col-sm-8">@Model.FechaConstruccion?.ToString("d")</dd><dt class="col-sm-4">País de fabricación</dt><dd class="col-sm-8">@Model.PaisFabricacion</dd><dt class="col-sm-4">Vehículo</dt><dd class="col-sm-8">@Model.Vehiculo</dd><dt class="col-sm-4">Material exterior</dt><dd class="col-sm-8">@Model.Material</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Baja?"Baja":"Activa")</dd></dl>
<h2 class="h4 mt-4">Capacidad y dimensiones</h2><dl class="row"><dt class="col-sm-4">Peso bruto</dt><dd class="col-sm-8">@Model.PesoBruto</dd><dt class="col-sm-4">Tara</dt><dd class="col-sm-8">@Model.Tara</dd><dt class="col-sm-4">Peso máximo producto</dt><dd class="col-sm-8">@Model.PesoMaxProducto</dd><dt class="col-sm-4">Longitud × ancho × alto</dt><dd class="col-sm-8">@Model.Longitud × @Model.Ancho × @Model.Alto</dd><dt class="col-sm-4">Peso máximo apilamiento</dt><dd class="col-sm-8">@Model.PesoMaxApilamiento</dd><dt class="col-sm-4">Carga de rigidez</dt><dd class="col-sm-8">@Model.CargaRigidez</dd></dl>
<h2 class="h4 mt-4">Aprobaciones y presiones</h2><dl class="row"><dt class="col-sm-4">Tipo IMO</dt><dd class="col-sm-8">@Model.NumTipoIMO</dd><dt class="col-sm-4">País de aprobación</dt><dd class="col-sm-8">@Model.PaisAprobacion</dd><dt class="col-sm-4">Autoridad</dt><dd class="col-sm-8">@Model.Autoridad</dd><dt class="col-sm-4">Código de diseño</dt><dd class="col-sm-8">@Model.CodigoDiseno</dd><dt class="col-sm-4">ADR</dt><dd class="col-sm-8">@Model.PresionServicioADR</dd><dt class="col-sm-4">IMO</dt><dd class="col-sm-8">@Model.PresionServicioIMO</dd><dt class="col-sm-4">Presión exterior</dt><dd class="col-sm-8">@Model.PresionExterior</dd><dt class="col-sm-4">Presión de prueba</dt><dd class="col-sm-8">@Model.PresionPrueba</dd><dt class="col-sm-4">Prueba hidráulica</dt><dd class="col-sm-8">@Model.PruebaHidraulica?.ToString("d")</dd><dt class="col-sm-4">Aprobación CSC</dt><dd class="col-sm-8">@Model.NumAprobacionCSC</dd><dt class="col-sm-4">Aprobación IMDG</dt><dd class="col-sm-8">@Model.NumAprobacionIMDG</dd><dt class="col-sm-4">Aprobación ADR/RID</dt><dd class="col-sm-8">@Model.NumAprobacionADR_RID</dd><dt class="col-sm-4">UN portable tank</dt><dd class="col-sm-8">@Model.UNPortableTank</dd></dl>
<h2 class="h4 mt-4">Compartimentos</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Número</th><th>Capacidad</th><th>Material interior</th></tr></thead><tbody>@if(Model.Compartimentos.Count==0){<tr><td colspan="3" class="text-body-secondary">No hay compartimentos registrados.</td></tr>}@foreach(var compartimento in Model.Compartimentos){<tr><td>@compartimento.Numero</td><td>@(compartimento.Capacidad?.ToString("N0")??"—") L</td><td>@compartimento.Material</td></tr>}</tbody></table></div>
<h2 class="h4 mt-4">Imágenes</h2>
@if(Model.Fotos.Count==0){<p class="text-body-secondary">No existen imágenes para esta cuba.</p>}
else { <div class="row g-3">@foreach(var foto in Model.Fotos){<div class="col-6 col-md-4 col-lg-3"><a asp-area="Mantenimiento" asp-controller="FotosActivos" asp-action="Foto" asp-route-id="@foto.Id" target="_blank" class="d-block"><img src="@Url.Action("Foto", "FotosActivos", new { area="Mantenimiento", id=foto.Id })" class="img-fluid rounded border" alt="@(foto.Observacion ?? "Imagen de la cuba")" loading="lazy" /></a>@if (!string.IsNullOrWhiteSpace(foto.Observacion)) { <div class="mt-1">@foto.Observacion</div> }</div>}</div> }
<a asp-action="Index" class="btn btn-outline-secondary">Volver a cubas</a>
