@model CubaFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Crear cuba" : "Editar cuba"; var action = Model.Id == 0 ? "Create" : "Edit"; }
<h1>@ViewData["Title"]</h1><form asp-action="@action" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="Id" type="hidden" />
<h2 class="h5">Identificación</h2><div class="row g-3 mb-4"><div class="col-md-4"><label asp-for="Matricula" class="form-label"></label><input asp-for="Matricula" class="form-control"/><span asp-validation-for="Matricula" class="text-danger"></span></div><div class="col-md-4"><label asp-for="NumCuadro" class="form-label"></label><input asp-for="NumCuadro" class="form-control"/></div><div class="col-md-4"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" class="form-control"/></div><div class="col-md-4"><label asp-for="Constructor" class="form-label"></label><input asp-for="Constructor" class="form-control"/></div><div class="col-md-4"><label asp-for="NumFabricacion" class="form-label"></label><input asp-for="NumFabricacion" class="form-control"/></div><div class="col-md-4"><label asp-for="NumHomologacion" class="form-label"></label><input asp-for="NumHomologacion" class="form-control"/></div><div class="col-md-4"><label asp-for="FechaConstruccion" class="form-label"></label><input asp-for="FechaConstruccion" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="PaisFabricacion" class="form-label"></label><input asp-for="PaisFabricacion" class="form-control"/></div><div class="col-md-4"><label asp-for="MaterialId" class="form-label"></label><select asp-for="MaterialId" asp-items="Model.Materiales" class="form-select"><option value="">Selecciona material</option></select></div><div class="col-md-6"><label asp-for="PlataformaId" class="form-label"></label><select asp-for="PlataformaId" asp-items="Model.Vehiculos" class="form-select"><option value="">Sin vehículo asociado</option></select></div></div>
<h2 class="h5">Presiones y pesos</h2><div class="row g-3 mb-4"><div class="col-md-3"><label asp-for="PesoBruto" class="form-label"></label><input asp-for="PesoBruto" class="form-control"/></div><div class="col-md-3"><label asp-for="Tara" class="form-label"></label><input asp-for="Tara" class="form-control"/></div><div class="col-md-3"><label asp-for="PesoMaxProducto" class="form-label"></label><input asp-for="PesoMaxProducto" class="form-control"/><div class="form-text">Si se deja vacío, se calcula con peso bruto menos tara.</div></div><div class="col-md-3"><label asp-for="PresionServicioADR" class="form-label"></label><input asp-for="PresionServicioADR" class="form-control"/></div><div class="col-md-3"><label asp-for="PresionServicioIMO" class="form-label"></label><input asp-for="PresionServicioIMO" class="form-control"/></div><div class="col-md-3"><label asp-for="PresionExterior" class="form-label"></label><input asp-for="PresionExterior" class="form-control"/></div><div class="col-md-3"><label asp-for="PresionTaradoValvulas" class="form-label"></label><input asp-for="PresionTaradoValvulas" class="form-control"/></div><div class="col-md-3"><label asp-for="PresionPrueba" class="form-label"></label><input asp-for="PresionPrueba" class="form-control"/></div><div class="col-md-3"><label asp-for="PruebaHidraulica" class="form-label"></label><input asp-for="PruebaHidraulica" type="date" class="form-control"/></div></div>
<h2 class="h5">Diseño y dimensiones</h2><div class="row g-3 mb-4"><div class="col-md-3"><label asp-for="NumTipoIMO" class="form-label"></label><input asp-for="NumTipoIMO" class="form-control"/></div><div class="col-md-3"><label asp-for="PaisAprobacion" class="form-label"></label><input asp-for="PaisAprobacion" class="form-control"/></div><div class="col-md-3"><label asp-for="Autoridad" class="form-label"></label><input asp-for="Autoridad" class="form-control"/></div><div class="col-md-3"><label asp-for="CodigoDiseno" class="form-label"></label><input asp-for="CodigoDiseno" class="form-control"/></div><div class="col-md-3"><label asp-for="TemperaturaCalculoReferencia" class="form-label"></label><input asp-for="TemperaturaCalculoReferencia" class="form-control"/></div><div class="col-md-3"><label asp-for="EspesorCuerpo" class="form-label"></label><input asp-for="EspesorCuerpo" class="form-control"/></div><div class="col-md-3"><label asp-for="EspesorFondo" class="form-label"></label><input asp-for="EspesorFondo" class="form-control"/></div><div class="col-md-3"><label asp-for="EspesorEquivalente" class="form-label"></label><input asp-for="EspesorEquivalente" class="form-control"/></div><div class="col-md-3"><label asp-for="TipoForro" class="form-label"></label><input asp-for="TipoForro" class="form-control"/></div><div class="col-md-3"><label asp-for="Modelo" class="form-label"></label><input asp-for="Modelo" class="form-control"/></div><div class="col-md-3"><label asp-for="PesoMaxApilamiento" class="form-label"></label><input asp-for="PesoMaxApilamiento" class="form-control"/></div><div class="col-md-3"><label asp-for="CargaRigidez" class="form-label"></label><input asp-for="CargaRigidez" class="form-control"/></div><div class="col-md-3"><label asp-for="Longitud" class="form-label"></label><input asp-for="Longitud" class="form-control"/></div><div class="col-md-3"><label asp-for="Ancho" class="form-label"></label><input asp-for="Ancho" class="form-control"/></div><div class="col-md-3"><label asp-for="Alto" class="form-label"></label><input asp-for="Alto" class="form-control"/></div><div class="col-md-3"><label asp-for="TemperaturaMinCarga" class="form-label"></label><input asp-for="TemperaturaMinCarga" class="form-control"/></div></div>
<h2 class="h5">Certificaciones</h2><div class="row g-3 mb-4"><div class="col-md-3"><label asp-for="NumAprobacionCSC" class="form-label"></label><input asp-for="NumAprobacionCSC" class="form-control"/></div><div class="col-md-3"><label asp-for="NumAprobacionIMDG" class="form-label"></label><input asp-for="NumAprobacionIMDG" class="form-control"/></div><div class="col-md-3"><label asp-for="NumAprobacionADR_RID" class="form-label"></label><input asp-for="NumAprobacionADR_RID" class="form-control"/></div><div class="col-md-3"><label asp-for="UNPortableTank" class="form-label"></label><input asp-for="UNPortableTank" class="form-control"/></div><div class="col-md-3"><label asp-for="NumAprobacion" class="form-label"></label><input asp-for="NumAprobacion" class="form-control"/></div></div>
<div class="form-check mb-3"><input asp-for="Baja" class="form-check-input"/><label asp-for="Baja" class="form-check-label"></label></div><button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form>
