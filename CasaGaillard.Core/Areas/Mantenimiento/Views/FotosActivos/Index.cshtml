@model InstalacionEquipoFotosViewModel
@{
    ViewData["Title"] = "Fotos del activo";
    var backController = Model.Tipo == "Instalacion" ? "Instalaciones" : "Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1>Fotos</h1><p class="text-body-secondary mb-0">@Model.Titulo</p></div>
    <a asp-area="Mantenimiento" asp-controller="@backController" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div asp-validation-summary="All" class="text-danger mb-3"></div>
@if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
{
    <form asp-action="Subir" method="post" enctype="multipart/form-data" class="card card-body mb-4">
        @Html.AntiForgeryToken()
        <input asp-for="Tipo" type="hidden" /><input asp-for="ActivoId" type="hidden" />
        <label asp-for="Archivos" class="form-label">Añadir imágenes (máximo 10, 5 MB por imagen)</label>
        <input asp-for="Archivos" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" multiple />
        <div class="mt-3"><button class="btn btn-primary" type="submit">Subir imágenes</button></div>
    </form>
}
@if (Model.Fotos.Count == 0)
{
    <p class="text-body-secondary">Este activo todavía no tiene fotos.</p>
}
else
{
    <div class="row g-3">
    @foreach (var foto in Model.Fotos)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100">
                <a asp-action="Foto" asp-route-id="@foto.Id" target="_blank"><img src="@Url.Action("Foto", new { id = foto.Id })" class="card-img-top" alt="@foto.NombreOriginal" style="height:200px;object-fit:cover" loading="lazy" /></a>
                <div class="card-body"><div class="small text-break">@foto.NombreOriginal</div><div class="small text-body-secondary">@foto.FechaCreacion.ToString("g")</div></div>
                @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
                {
                    <div class="card-footer"><form asp-action="Eliminar" asp-route-id="@foto.Id" method="post" onsubmit="return confirm('¿Eliminar esta imagen?');"><button class="btn btn-outline-danger btn-sm" type="submit">Eliminar</button></form></div>
                }
            </div>
        </div>
    }
    </div>
}
