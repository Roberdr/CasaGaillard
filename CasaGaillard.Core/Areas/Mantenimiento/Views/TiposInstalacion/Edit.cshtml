@model TipoInstalacionCatalogoViewModel
@{ ViewData["Title"] = "Editar tipo de instalación"; }
<h1>Editar tipo de instalación</h1>
<form asp-action="Edit" method="post" class="col-lg-8">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</form>
