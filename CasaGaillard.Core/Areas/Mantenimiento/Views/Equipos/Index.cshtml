@model IReadOnlyList<EquipoFilaViewModel>
@{
    ViewData["Title"] = "Equipos de instalaciones";
    var instalacionId = ViewData["InstalacionId"] as int?;
    var incluirBajas = ViewData["IncluirBajas"] as bool? ?? false;
    var instalaciones = (IEnumerable<SelectListItem>)ViewData["Instalaciones"]!;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Equipos de instalaciones</h1>
    @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento")) { <a asp-action="Create" asp-route-instalacionId="@instalacionId" class="btn btn-success">Nuevo equipo</a> }
</div>
@if (TempData["LoginMessage"] is string message) { <div class="alert alert-info">@message</div> }
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5"><select name="instalacionId" asp-items="@instalaciones" class="form-select"><option value="">Todas las instalaciones</option></select></div>
    @if (incluirBajas) { <input type="hidden" name="incluirBajas" value="true" /> }
    <div class="col-auto"><button type="submit" class="btn btn-primary">Filtrar</button></div>
    @if (incluirBajas) { <div class="col-auto"><a asp-action="Index" asp-route-instalacionId="@instalacionId" class="btn btn-outline-secondary">Ocultar inactivos</a></div> }
    else { <div class="col-auto"><a asp-action="Index" asp-route-instalacionId="@instalacionId" asp-route-incluirBajas="true" class="btn btn-outline-secondary">Mostrar inactivos</a></div> }
</form>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead><tr><th>Instalación</th><th>Tipo</th><th>Código</th><th>Elemento / padre</th><th>Fabricante / modelo</th><th>Número de serie</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-body-secondary">No hay equipos.</td></tr> }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.InstalacionNombre</td><td>@item.TipoElemento</td><td>@item.Codigo</td>
                <td><span style="padding-left:@(item.Nivel * 20)px">@(item.Nivel > 0 ? "└ " : "")@item.Nombre</span>@if (!string.IsNullOrWhiteSpace(item.PadreNombre)) { <small class="text-body-secondary"><br />Padre: @item.PadreNombre</small> }</td>
                <td>@item.Fabricante @item.Modelo</td><td>@item.NumeroSerie</td><td>@(item.Activo ? "Activo" : "Inactivo")</td>
                <td class="text-nowrap">
                    <a asp-area="Mantenimiento" asp-controller="FotosActivos" asp-action="Index" asp-route-tipo="Equipo" asp-route-id="@item.Id">Fotos</a>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        @if (item.Activo)
                        {
                            <form asp-action="DarDeBaja" asp-route-id="@item.Id" asp-route-instalacionId="@instalacionId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link" onclick="return confirm('¿Marcar este equipo como inactivo?');">Dar de baja</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
