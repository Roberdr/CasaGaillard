@model IReadOnlyList<RevisionVehiculoFilaViewModel>
@{ ViewData["Title"] = "Revisiones de vehículos"; var matricula = ViewData["MatriculaVehiculo"] as string; var incluirBajas = (bool)(ViewData["IncluirBajas"] ?? false); }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Revisiones de vehículos</h1><div><a asp-action="Proximas" class="btn btn-outline-primary">Próximas caducidades</a> <a asp-action="Create" asp-route-vehiculoId="@(Context.Request.Query["vehiculoID"] )" class="btn btn-success">Nueva revisión</a></div></div>
@if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><label for="matriculaVehiculo" class="form-label">Matrícula</label><input id="matriculaVehiculo" name="matriculaVehiculo" value="@matricula" class="form-control" /></div><div class="col-auto d-flex align-items-end"><button class="btn btn-primary">Filtrar</button></div><div class="col-auto d-flex align-items-end"><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="incluirBajas" name="incluirBajas" value="true" checked="@(incluirBajas ? "checked" : null)" /><label class="form-check-label" for="incluirBajas">Incluir vehículos dados de baja</label></div></div></form>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Matrícula</th><th>Tipo</th><th>Fecha</th><th>Caducidad</th><th>Ejecutor</th><th>Detalles</th><th>Reserva</th><th></th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-body-secondary">No hay revisiones registradas.</td></tr> }
@foreach (var row in Model) { <tr><td>@row.Matricula</td><td>@row.TipoRevision</td><td>@row.FechaRevision?.ToString("d")</td><td>@row.Caducidad?.ToString("d")</td><td>@row.Ejecutor</td><td>@row.Detalles</td><td>
    @if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
    {
        <form asp-action="ActualizarReserva" method="post" class="d-flex flex-wrap align-items-center gap-2" data-auto-submit-reserva>
            <input type="hidden" name="id" value="@row.Id" /><input type="hidden" name="matriculaVehiculo" value="@matricula" /><input type="hidden" name="incluirBajas" value="@incluirBajas" />
            <input class="form-control form-control-sm" type="date" name="fechaReservada" value="@row.FechaReservada?.ToString("yyyy-MM-dd")" aria-label="Fecha reservada" style="max-width: 10rem" />
        </form>
    }
    else { <span>@(row.FechaReservada?.ToString("dd/MM/yyyy") ?? "—")</span> }
</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@row.Id">Detalles</a> · <a asp-action="Edit" asp-route-id="@row.Id">Editar</a> · <a asp-action="Delete" asp-route-id="@row.Id">Eliminar</a></td></tr> }
</tbody></table></div>
@section Scripts { <script src="~/js/reserva-revision-auto.js" asp-append-version="true"></script> }
