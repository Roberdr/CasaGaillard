@model MantenimientoDashboardViewModel
@{ ViewData["Title"]="Mantenimiento"; }
<div class="mb-4"><h1>CASA GAILLARD S.A.</h1><p class="lead">Control del mantenimiento de la empresa</p></div>
<div class="row g-4">
    <section class="col-xl-4"><div class="card h-100"><div class="card-header d-flex justify-content-between"><h2 class="h5 mb-0">Revisiones de cubas</h2><a asp-controller="Revisiones" asp-action="Index">Ver todas</a></div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Matrícula</th><th>Validez</th><th>Tipo próximo</th></tr></thead><tbody>@if(Model.RevisionesCubas.Count==0){<tr><td colspan="3" class="text-body-secondary">No hay caducidades próximas.</td></tr>}@foreach(var r in Model.RevisionesCubas){<tr><td><a asp-controller="Revisiones" asp-action="Index" asp-route-cubaId="@r.CubaId">@r.MatriculaCuba</a></td><td>@r.ValidaHasta?.ToString("d")</td><td>@r.DescripcionProxima</td></tr>}</tbody></table></div></div></section>
    <section class="col-xl-4"><div class="card h-100"><div class="card-header d-flex justify-content-between"><h2 class="h5 mb-0">Próximas ITV</h2><a asp-controller="RevisionesVehiculos" asp-action="Index">Ver todas</a></div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Matrícula</th><th>Validez</th><th>Tipo</th></tr></thead><tbody>@if(Model.RevisionesVehiculos.Count==0){<tr><td colspan="3" class="text-body-secondary">No hay ITV próximas.</td></tr>}@foreach(var r in Model.RevisionesVehiculos){<tr><td><a asp-controller="RevisionesVehiculos" asp-action="Index" asp-route-matriculaVehiculo="@r.MatriculaVehiculo">@r.MatriculaVehiculo</a></td><td>@r.Caducidad?.ToString("d")</td><td>@r.TipoRevision</td></tr>}</tbody></table></div></div></section>
    <section class="col-xl-4"><div class="card h-100"><div class="card-header d-flex justify-content-between"><h2 class="h5 mb-0">Tareas recientes</h2><a asp-controller="TareasMantenimiento" asp-action="Index">Ver tareas</a></div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Equipo</th><th>Estado</th><th>Prioridad</th></tr></thead><tbody>@if(Model.Tareas.Count==0){<tr><td colspan="3" class="text-body-secondary">No hay tareas registradas.</td></tr>}@foreach(var t in Model.Tareas){<tr><td><a asp-controller="TareasMantenimiento" asp-action="Index" asp-route-codigo="@t.Codigo">@(t.Equipo??t.Titulo)</a></td><td>@t.Estado</td><td>@t.Prioridad</td></tr>}</tbody></table></div></div></section>
</div>
