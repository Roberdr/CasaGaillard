@model IEnumerable<UsuarioFilaViewModel>
@{ ViewData["Title"] = "Usuarios"; }
<h1>Usuarios</h1>
@if (TempData["LoginMessage"] is string message) { <div class="alert alert-success">@message</div> }
<p><a asp-action="Create" class="btn btn-primary">Crear cuenta de usuario</a></p>
<div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>Correo</th><th>Persona</th><th>Usuario</th><th>Roles</th><th></th></tr></thead><tbody>
@foreach (var user in Model)
{
    <tr><td>@user.Email</td><td>@(string.IsNullOrWhiteSpace(user.Persona) ? "Sin persona" : user.Persona)</td><td>@user.UserName</td><td>@string.Join(", ", user.Roles)</td><td class="text-nowrap">
        @if (string.IsNullOrWhiteSpace(user.Persona)) { <a asp-action="VincularPersona" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Vincular persona</a> }
        <a asp-action="Roles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Roles</a>
        <form asp-action="GenerarEnlaceRestablecimiento" method="post" class="d-inline"><input type="hidden" name="id" value="@user.Id" /><button type="submit" class="btn btn-sm btn-primary">Enlace de restablecimiento</button></form>
    </td></tr>
}
</tbody></table></div>
