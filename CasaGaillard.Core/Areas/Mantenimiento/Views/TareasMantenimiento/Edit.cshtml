@model TareaMantenimientoFormViewModel
@{
    ViewData["Title"] = "Editar tarea";
}

<h1>Editar tarea de mantenimiento</h1>
<div class="alert alert-info"><strong>Código:</strong> @Model.Codigo<br /><strong>Creada:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")<br />
    @if (!string.IsNullOrWhiteSpace(Model.CreadoPor)) { <span><strong>Creada por:</strong> @Model.CreadoPor<br /></span> }
    @if (Model.FechaActualizacion.HasValue) { <span><strong>Actualizada:</strong> @Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")<br /></span> }
    @if (!string.IsNullOrWhiteSpace(Model.ActualizadoPor)) { <span><strong>Actualizada por:</strong> @Model.ActualizadoPor</span> }
</div>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input asp-for="ID" type="hidden" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-link">Cancelar</a>
</form>

@section Scripts { <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" /> }
