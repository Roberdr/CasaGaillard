@model TareaMantenimientoFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" rows="5" class="form-control"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="Ubicacion" class="form-label"></label><input asp-for="Ubicacion" class="form-control" /><span asp-validation-for="Ubicacion" class="text-danger"></span></div>
    <div class="col-md-6 mb-3"><label asp-for="Equipo" class="form-label"></label><input asp-for="Equipo" class="form-control" /><span asp-validation-for="Equipo" class="text-danger"></span></div>
</div>
<h2 class="h5 mt-3">Activo relacionado</h2>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="InstalacionId" class="form-label">Instalación</label><select asp-for="InstalacionId" asp-items="Model.Instalaciones" class="form-select"><option value="">Sin instalación</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="EquipoId" class="form-label">Equipo</label><select asp-for="EquipoId" asp-items="Model.Equipos" class="form-select"><option value="">Sin equipo</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="CubaId" class="form-label">Cisterna</label><select asp-for="CubaId" asp-items="Model.Cubas" class="form-select"><option value="">Sin cisterna</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="GrupoId" class="form-label">Grupo</label><select asp-for="GrupoId" asp-items="Model.Grupos" class="form-select"><option value="">Sin grupo</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="VehiculoId" class="form-label">Vehículo</label><select asp-for="VehiculoId" asp-items="Model.Vehiculos" class="form-select"><option value="">Sin vehículo</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="PlanMantenimientoId" class="form-label">Plan de mantenimiento</label><select asp-for="PlanMantenimientoId" asp-items="Model.PlanesMantenimiento" class="form-select"><option value="">Sin plan</option></select></div>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="DetectadoPorPersonaID" class="form-label">Detectado por</label><select asp-for="DetectadoPorPersonaID" asp-items="Model.Personas" class="form-select"><option value="">Sin indicar</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="ContactoPersonaID" class="form-label">Contacto</label><select asp-for="ContactoPersonaID" asp-items="Model.Contactos" class="form-select"><option value="">Sin indicar</option></select></div>
</div>
@if (User.IsInRole("Administrador") || User.IsInRole("Mantenimiento"))
{
    <div class="mb-3 d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-sm btn-outline-primary js-nueva-persona" data-target="DetectadoPorPersonaID">+ Nueva persona para «Detectado por»</button>
        <button type="button" class="btn btn-sm btn-outline-primary js-nueva-persona" data-target="ContactoPersonaID">+ Nueva persona para «Contacto»</button>
        <button type="button" class="btn btn-sm btn-outline-primary js-nueva-persona" data-target="AsignadaAPersonaID">+ Nueva persona para «Asignada a»</button>
    </div>
    <dialog id="nuevaPersonaDialog" class="border-0 rounded shadow p-0" style="max-width: 32rem; width: calc(100% - 2rem)">
        <div class="p-4">
            <h2 class="h5">Crear persona</h2>
            <div id="nuevaPersonaError" class="alert alert-danger d-none" role="alert"></div>
            <div class="mb-3"><label for="nuevaPersonaNombre" class="form-label">Nombre</label><input id="nuevaPersonaNombre" class="form-control" maxlength="50" required /></div>
            <div class="mb-3"><label for="nuevaPersonaApellido1" class="form-label">Primer apellido</label><input id="nuevaPersonaApellido1" class="form-control" maxlength="50" required /></div>
            <div class="mb-3"><label for="nuevaPersonaApellido2" class="form-label">Segundo apellido</label><input id="nuevaPersonaApellido2" class="form-control" maxlength="50" /></div>
            <div class="mb-3"><label for="nuevaPersonaNif" class="form-label">NIF</label><input id="nuevaPersonaNif" class="form-control" maxlength="10" required /></div>
            <div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-outline-secondary" id="cancelarNuevaPersona">Cancelar</button><button type="button" class="btn btn-primary" id="guardarNuevaPersona">Crear persona</button></div>
        </div>
    </dialog>
    <script>
        (() => {
            const dialog = document.getElementById('nuevaPersonaDialog');
            const error = document.getElementById('nuevaPersonaError');
            let target;
            document.querySelectorAll('.js-nueva-persona').forEach(button => button.addEventListener('click', () => {
                target = document.getElementById(button.dataset.target);
                error.classList.add('d-none');
                dialog.showModal();
                document.getElementById('nuevaPersonaNombre').focus();
            }));
            document.getElementById('cancelarNuevaPersona').addEventListener('click', () => dialog.close());
            document.getElementById('guardarNuevaPersona').addEventListener('click', async event => {
                const save = event.currentTarget;
                save.disabled = true;
                error.classList.add('d-none');
                const data = new URLSearchParams({
                    Nombre: document.getElementById('nuevaPersonaNombre').value.trim(),
                    Apellido1: document.getElementById('nuevaPersonaApellido1').value.trim(),
                    Apellido2: document.getElementById('nuevaPersonaApellido2').value.trim(),
                    Nif: document.getElementById('nuevaPersonaNif').value.trim(),
                    __RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]').value
                });
                try {
                    const response = await fetch('@Url.Action("CrearPersona", "TareasMantenimiento", new { area = "Mantenimiento" })', {
                        method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' }, body: data
                    });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.error || 'No se pudo crear la persona.');
                    ["DetectadoPorPersonaID", "ContactoPersonaID", "AsignadaAPersonaID"].forEach(id => {
                        const select = document.getElementById(id);
                        select.add(new Option(result.nombre, result.id));
                    });
                    target.value = result.id;
                    dialog.close();
                    ["nuevaPersonaNombre", "nuevaPersonaApellido1", "nuevaPersonaApellido2", "nuevaPersonaNif"].forEach(id => document.getElementById(id).value = '');
                } catch (failure) {
                    error.textContent = failure.message;
                    error.classList.remove('d-none');
                } finally {
                    save.disabled = false;
                }
            });
        })();
    </script>
}
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="Prioridad" class="form-label"></label><select asp-for="Prioridad" class="form-select"><option>Baja</option><option>Media</option><option>Alta</option><option>Urgente</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select"><option>Nueva</option><option>En estudio</option><option>Asignada</option><option>En curso</option><option>Pendiente repuestos</option><option>Cerrada</option></select></div>
</div>
<div class="row">
    <div class="col-md-6 mb-3"><label asp-for="AsignadaAPersonaID" class="form-label">Asignada a</label><select asp-for="AsignadaAPersonaID" asp-items="Model.Asignados" class="form-select"><option value="">Sin asignar</option></select></div>
    <div class="col-md-6 mb-3"><label asp-for="EmpresaExteriorEntidadID" class="form-label">Empresa exterior</label><select asp-for="EmpresaExteriorEntidadID" asp-items="Model.Entidades" class="form-select"><option value="">Sin empresa</option></select></div>
</div>
<div class="mb-3"><label asp-for="FechaDeteccion" class="form-label"></label><input asp-for="FechaDeteccion" type="datetime-local" class="form-control" /><span asp-validation-for="FechaDeteccion" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="FechaProgramada" class="form-label"></label><input asp-for="FechaProgramada" type="date" class="form-control" /><span asp-validation-for="FechaProgramada" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="AccionesARealizar" class="form-label"></label><textarea asp-for="AccionesARealizar" rows="4" class="form-control"></textarea></div>
<div class="mb-3"><label asp-for="AccesoriosNecesarios" class="form-label"></label><input asp-for="AccesoriosNecesarios" class="form-control" placeholder="Ejemplo: 12,18,24" /><span asp-validation-for="AccesoriosNecesarios" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Observaciones" class="form-label"></label><textarea asp-for="Observaciones" rows="4" class="form-control"></textarea></div>
<div class="mb-3" data-foto-pies data-campo="ObservacionesFotos"><label asp-for="FotosAdjuntas" class="form-label"></label><input asp-for="FotosAdjuntas" type="file" accept="image/*" capture="environment" multiple class="form-control" /><div data-foto-pies-lista class="mt-2"></div><span asp-validation-for="FotosAdjuntas" class="text-danger"></span><div class="form-text">Opcional. Puedes tomar fotos con la cámara del móvil o elegirlas de la galería. Hasta 10 MB cada una.</div></div>
<script src="~/js/foto-pies.js" asp-append-version="true"></script>
