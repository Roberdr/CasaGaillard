@model PaginaStockViewModel
@{ViewData["Title"]="Stock";}
<section class="public-section public-section--tight"><div class="container"><div class="public-page-head"><div><span class="public-kicker">Stock público</span><h1>Productos visibles</h1><p class="text-muted">Catálogo público de productos con una visión de su composición y presencia en compartimentos.</p></div></div>
<div class="public-stock-toolbar" data-stock-filter-root><div class="public-stock-toolbar__search"><label for="stockFilter">Buscar producto</label><input type="search" id="stockFilter" class="form-control public-stock-filter" placeholder="Nombre, fórmula, UN, grupo o material"/></div><div class="public-stock-toolbar__status"><span id="stockCounter" class="public-chip public-chip--muted">0 visibles</span><button type="button" id="stockClear" class="btn btn-link public-link">Limpiar filtro</button></div></div>
@if(Model.CatalogoNoDisponible){<div class="public-note">El catálogo está temporalmente no disponible.</div>}else if(Model.Productos.Count==0){<div class="public-note">No hay productos visibles en el catálogo.</div>}else{<div class="public-grid" id="stockGrid">@foreach(var p in Model.Productos){var search=string.Join(" ",new[]{p.Nombre,p.Formula,p.Iupac,p.NumeroUN,p.MaterialPredominante,p.Grupo.HasValue?"grupo "+p.Grupo.Value:null}.Where(x=>!string.IsNullOrWhiteSpace(x)));<article class="public-product-card" data-stock-card data-search="@search"><div class="public-product-card__top"><h3>@p.Nombre</h3><span class="public-chip">Grupo @(p.Grupo?.ToString()??"N/D")</span></div><p class="public-product-card__formula">@p.Formula</p><dl class="public-definition"><div><dt>IUPAC</dt><dd>@(p.Iupac??"No disponible")</dd></div><div><dt>UN</dt><dd>@(p.NumeroUN??"N/D")</dd></div><div><dt>Compartimentos</dt><dd>@p.TotalCompartimentos</dd></div><div><dt>Capacidad</dt><dd>@(p.CapacidadTotal?.ToString("N0")??"N/D")</dd></div><div class="public-definition__wide"><dt>Material</dt><dd>@(p.MaterialPredominante??"No disponible")</dd></div></dl></article>}</div>}</div></section>
@section Scripts { <script src="~/js/public-stock.js" asp-append-version="true"></script> }
