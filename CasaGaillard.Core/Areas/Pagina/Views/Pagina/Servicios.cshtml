@model IReadOnlyList<ServicioPublicoViewModel>
@{ViewData["Title"]="Servicios";}
<section class="public-section public-section--tight"><div class="container"><div class="public-page-head"><div><span class="public-kicker">Servicios</span><h1>Líneas de trabajo</h1><p class="text-muted">Una visión clara de las líneas de trabajo que la empresa ofrece habitualmente.</p></div></div><div class="public-note public-note--accent">Suministro, logística y soporte para clientes profesionales.</div><div class="public-grid public-grid--three">@foreach(var s in Model){<article class="public-product-card public-product-card--service"><div class="public-product-card__top"><h3>@s.Titulo</h3><span class="public-chip public-chip--muted">Servicio</span></div><p class="public-product-card__formula">@s.Descripcion</p><p class="text-muted">@s.Detalle</p></article>}</div></div></section>
