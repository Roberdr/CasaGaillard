@model PaginaInicioViewModel
@{ ViewData["Title"]="Inicio"; }
<section class="pagina-hero"><div class="container"><div class="hero-inner"><div class="hero-brand"><img src="@Url.Action("Imagen",new{archivo="logo_gaillard.JPeG"})" alt="Casa Gaillard" /></div><div class="hero-copy"><h1>Casa Gaillard S.A.</h1><h3>Almacenaje y distribución de productos químicos a granel — desde 1924</h3><p style="margin-top:12px;max-width:720px;color:#475569">Especialistas en suministro, logística y distribución para la industria y clientes profesionales en las Islas Baleares. Soluciones seguras, trazables y con capacidad para manejo de cargas a granel.</p><div class="hero-cta"><a href="#contact" class="btn btn-primary">Contactar ahora</a><a asp-action="Servicios" class="btn btn-outline-primary ms-2">Nuestros servicios</a></div></div><div class="hero-media"><img src="@Url.Action("Imagen",new{archivo="Quimica.jpeg"})" alt="Almacenaje y logística" class="pagina-hero-image" /></div></div></div></section>
<section class="pagina-features"><div class="container"><div class="row"><div class="col-md-8"><div class="row g-3"><div class="col-md-6"><div class="feature-card"><h4>Logística propia</h4><p>Flota propia para distribución y descarga en cliente, con contenedores cisterna.</p></div></div><div class="col-md-6"><div class="feature-card"><h4>Almacenaje seguro</h4><p>Instalaciones en Polígono Son Castelló con zonas segregadas según compatibilidades.</p></div></div><div class="col-md-6"><div class="feature-card"><h4>Cumplimiento y seguridad</h4><p>Protocolos HSE, gestión de documentación y transporte ADR cuando procede.</p></div></div><div class="col-md-6"><div class="feature-card"><h4>Suministro a medida</h4><p>Suministro a granel y envasado, adaptado a las necesidades del cliente.</p></div></div></div></div><div class="col-md-4"><div class="safety-panel"><h5>Panel de seguridad</h5><p>Pictogramas y fichas de seguridad disponibles bajo petición.</p><ul><li>Transporte ADR</li><li>Almacenamiento segregado</li><li>Equipos EPI y formación continua</li></ul><a asp-action="Seguridad" class="btn btn-outline-primary">Seguridad</a></div></div></div></div></section>
<section class="pagina-gallery"><div class="container"><h3>Instalaciones</h3><div class="row">@foreach(var photo in new[]{"IMG_20201013_122605.jpg","DSC_0122.JPG","DSC_0296.JPG","IMG_20201013_122550.jpg"}){<div class="col-md-3 gallery-item"><img src="@Url.Action("Imagen",new{archivo=photo})" alt="Instalaciones de Casa Gaillard" loading="lazy"/></div>}</div></div></section>
<section class="public-home-section"><div class="container"><div class="public-grid public-grid--three"><article class="public-card public-card--intro"><span class="public-kicker">Catálogo</span><h3>@Model.TotalProductos</h3><p>productos registrados</p></article><article class="public-card public-card--intro"><span class="public-kicker">Almacenaje</span><h3>@Model.TotalCompartimentos</h3><p>compartimentos registrados</p></article><article class="public-card public-card--intro"><span class="public-kicker">Mantenimiento</span><h3>@Model.TotalServicios</h3><p>tipos de servicio</p></article></div>@if(Model.ProductosDestacados.Count>0){<div class="public-page-head mt-4"><div><span class="public-kicker">Catálogo</span><h2>Productos destacados</h2></div><a asp-action="Tienda" class="btn btn-outline-primary">Ver catálogo</a></div><div class="public-grid public-grid--four">@foreach(var p in Model.ProductosDestacados){<article class="public-product-card"><div class="public-product-card__top"><h3>@p.Nombre</h3><span class="public-chip">Grupo @(p.Grupo?.ToString()??"N/D")</span></div><p class="public-product-card__formula">@p.Formula</p><p class="text-muted">@p.TotalCompartimentos compartimentos · @(p.CapacidadTotal?.ToString("N0")??"N/D") de capacidad</p></article>}</div>}</div></section>
<section id="servicios" class="public-home-section public-home-copy"><div class="container"><h2>Nuestra actividad</h2><p>Nos ubicamos en el Polígono de Son Castelló, desde donde operamos con un amplio catálogo de productos químicos a granel y envasados, atendiendo a industria y clientes profesionales.</p><p>Contamos con capacidad de importación, almacenamiento y entrega local, así como servicios de descarga en destino con vehículos cisterna.</p><div class="d-flex gap-2"><a asp-action="Tienda" class="btn btn-primary">Consultar stock</a><a asp-action="Servicios" class="btn btn-outline-primary">Servicios</a></div></div></section>
<section id="contact" class="pagina-cta"><div class="container d-flex justify-content-between align-items-center flex-wrap gap-3" style="background-image:url('@Url.Action("Imagen",new{archivo="fondo-cabecera-contacto.jpg"})');background-size:cover;background-position:center;border-radius:8px;padding:18px"><div><h4>¿Necesita suministro o asesoramiento técnico?</h4><p>Contacte con nuestro departamento comercial y logístico para recibir una propuesta a medida.</p></div><a asp-action="Contacto" class="btn btn-primary">Contactar</a></div></section>
@if(Model.CatalogoNoDisponible){<div class="container"><div class="public-note">El catálogo está temporalmente no disponible.</div></div>}
