<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - CASA GAILLARD S.A.</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/public.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>@await RenderSectionAsync("Styles",required:false)</head>
<body class="public-body container">
<nav class="navbar sticky-top navbar-expand-lg bg-body-tertiary"><div class="container-fluid"><a class="navbar-brand" asp-area="Pagina" asp-controller="Pagina" asp-action="Index">CASA GAILLARD S.A.</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#public-navbar" aria-controls="public-navbar" aria-expanded="false" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="public-navbar"><ul class="navbar-nav me-auto"><li class="nav-item"><a asp-area="Pagina" asp-controller="Pagina" asp-action="Tienda" class="nav-link">Stock</a></li><li class="nav-item"><a asp-area="Pagina" asp-controller="Pagina" asp-action="Servicios" class="nav-link">Servicios</a></li><li class="nav-item"><a asp-area="Pagina" asp-controller="Pagina" asp-action="Seguridad" class="nav-link">Seguridad</a></li><li class="nav-item"><a asp-area="Pagina" asp-controller="Pagina" asp-action="AcercaDe" class="nav-link">Acerca de</a></li><li class="nav-item"><a asp-area="Pagina" asp-controller="Pagina" asp-action="Contacto" class="nav-link">Contacto</a></li></ul><ul class="navbar-nav">@if(User.Identity?.IsAuthenticated==true){<li class="nav-item"><a asp-area="Mantenimiento" asp-controller="Home" asp-action="Index" class="nav-link">Área interna</a></li><li class="nav-item"><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link btn btn-link">Cerrar sesión</button></form></li>}else{<li class="nav-item"><a asp-area="" asp-controller="Account" asp-action="Login" class="nav-link">Iniciar sesión</a></li>}</ul></div></div></nav>
<main class="public-main">@if(TempData["LoginMessage"] is string message){<div class="container"><div class="alert alert-info">@message</div></div>}@RenderBody()</main>
<footer class="public-footer"><div class="container public-footer__inner"><div><strong>Casa Gaillard S.A.</strong><span>Información pública, servicios y seguridad</span></div><div><span>&copy; @DateTime.Now.Year</span></div></div></footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)
</body></html>
