@using CasaGaillard.Models
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title CASA GAILLARD S.A.</title>
    @Styles.Render("~/bundles/styles")
    @Scripts.Render("~/bundles/modernizr")
    @*@Styles.Render("~/Content/fontawesome")*@
    @*<script src="https://kit.fontawesome.com/651504c62c.js" crossorigin="anonymous"></script>*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" integrity="sha512-+4zCK9k+qNFUR5X+cKL9EIR+ZOhtIloNl9GIKS57V1MyNsYpYcUrUeQc9vNfzsWfV28IaLL3i96P9sdNyeRssA==" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/fontawesome.css" integrity="sha512-qUzMY3p2A7wsZaOjjgE3UaFsM8R0hwxTGcQ/Z4vi3eHWg3J7BTyG+2JxjweaHWFrOkXCyvriwQqFMPCvHJmqyA==" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/regular.css" integrity="sha512-RVXK2JBDey8voSjvx1uTfOHjbIya6KE+ccmslcQEh5i5ZDS6u7Z2sJgTbwnXcqT1xcRIu+SogQRd7zVtfvqVOw==" crossorigin="anonymous" />
</head>
<body class="maintenance-body">
    <header class="maintenance-topbar">
        <div class="container-fluid maintenance-topbar__inner">
            <div class="maintenance-brand">
                <img src="~/Content/images/logo-casa.png" alt="Casa Gaillard" class="maintenance-brand__logo" />
                <div class="maintenance-brand__text">
                    <span>Casa Gaillard S.A.</span>
                    <small>Área de mantenimiento</small>
                </div>
            </div>
            <nav class="maintenance-nav">
                <ul class="maintenance-nav__list">
                    <li>@Html.ActionLink("Inicio", "Index", "Pagina", new { area = "Pagina" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                    @if (Request.IsAuthenticated)
                    {
                        <li>@Html.ActionLink("Panel", "Index", "Home", new { area = "Mantenimiento" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                        if (User.IsInRole(AppRoles.Administrador) || User.IsInRole(AppRoles.Mantenimiento))
                        {
                            <li>@Html.ActionLink("Tareas", "Index", "TareasMantenimiento", new { area = "Mantenimiento" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                            <li>@Html.ActionLink("Cubas", "Index", "Cubas", new { area = "Mantenimiento" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                            <li>@Html.ActionLink("Vehículos", "Index", "Vehiculos", new { area = "Mantenimiento" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                            <li>@Html.ActionLink("Grupos", "Index", "Grupos", new { area = "Mantenimiento" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                            <li>@Html.ActionLink("Accesorios", "Index", "Accesorios", new { area = "Mantenimiento" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                        }
                        if (User.IsInRole(AppRoles.Administrador))
                        {
                            <li>@Html.ActionLink("Usuarios", "Index", "Usuarios", new { area = "Mantenimiento" }, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                        }
                    }
                    <li>@Html.ActionLink("Acerca de", "About", "Home", routeValues: null, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                    <li>@Html.ActionLink("Contacto", "Contact", "Home", routeValues: null, htmlAttributes: new { @class = "maintenance-nav__link" })</li>
                </ul>
            </nav>
            <div class="maintenance-auth">
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </header>
    <main class="maintenance-main container-fluid">
        @if (TempData["LoginMessage"] != null)
        {
            <div class="alert alert-info" role="alert">@TempData["LoginMessage"]</div>
        }
        @RenderBody()
    </main>
    <footer class="maintenance-footer">
        <div class="container-fluid maintenance-footer__inner">
            <span>&copy; @DateTime.Now.Year - Mantenimiento Casa Gaillard</span>
            <span>Gestión interna y control operativo</span>
        </div>
    </footer>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/js")
    @RenderSection("scripts", required: false)
</body>
</html>
