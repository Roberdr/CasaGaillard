@model CasaGaillard.Models.Persona
@{
    ViewBag.Title = "Ficha de persona";
}

<h2>Ficha de persona</h2>
<dl class="dl-horizontal">
    <dt>Nombre</dt><dd>@Model.NombrePersona @Model.Apellido1 @Model.Apellido2</dd>
    <dt>NIF</dt><dd>@Model.NIF</dd>
    <dt>Dirección</dt><dd>@(Model.Direccion == null ? "Sin dirección" : Model.Direccion.NombreVia + " " + Model.Direccion.Numero + ", " + Model.Direccion.Poblacion.NombrePoblacion)</dd>
</dl>

<h3>Teléfonos</h3>
@if (TempData["PersonaError"] != null) { <div class="alert alert-danger">@TempData["PersonaError"]</div> }
<div class="persona-telefonos" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:12px;">
    @foreach (var telefono in Model.TelefonosPersona)
    {
        <div style="position:relative; display:inline-flex; align-items:center; padding:6px 18px 6px 6px; border:1px solid #ccc; border-radius:4px;">
            @using (Html.BeginForm("ActualizarTelefono", "Personas", FormMethod.Post, new { style = "margin:0;" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("personaID", Model.ID)
                @Html.Hidden("id", telefono.ID)
                @Html.Hidden("returnTo", "Details")
                @Html.TextBox("telefono", telefono.TelefonoPersona1.Trim(), new { @class = "form-control", maxlength = "10", size = "10", style = "width:12ch; border:0; box-shadow:none; padding:0;", onkeydown = "if(event.key === 'Enter'){event.preventDefault(); this.form.submit();}" })
            }
            @using (Html.BeginForm("EliminarTelefono", "Personas", FormMethod.Post, new { style = "position:absolute; top:-8px; right:-8px; margin:0;" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("personaID", Model.ID)
                @Html.Hidden("id", telefono.ID)
                @Html.Hidden("returnTo", "Details")
                <button type="submit" aria-label="Eliminar teléfono" title="Eliminar teléfono" class="btn btn-danger btn-xs" style="width:20px; height:20px; padding:0; border-radius:50%; line-height:18px;">×</button>
            }
        </div>
    }
    @using (Html.BeginForm("AgregarTelefono", "Personas", FormMethod.Post, new { style = "margin:0;" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("personaID", Model.ID)
        @Html.Hidden("returnTo", "Details")
        <div style="display:flex; align-items:center; gap:4px;">
            <input name="telefono" maxlength="10" size="10" class="form-control" style="width:12ch;" placeholder="Nuevo teléfono" aria-label="Nuevo teléfono" />
            <button type="submit" aria-label="Añadir teléfono" title="Añadir teléfono" class="btn btn-success" style="width:34px; height:34px; padding:0; font-size:22px;">+</button>
        </div>
    }
</div>

@Html.Partial("_RelacionesEntidad", Model)
<p>@Html.ActionLink("Editar", "Edit", new { id = Model.ID }, new { @class = "btn btn-primary" }) @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-default" })</p>
