@model CasaGaillard.Models.Persona

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Persona</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ID)

        <div class="form-group">
            @Html.LabelFor(model => model.NombrePersona, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NombrePersona, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NombrePersona, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Apellido1, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Apellido1, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Apellido1, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Apellido2, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Apellido2, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Apellido2, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.NIF, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NIF, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NIF, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DireccionID, "Direccion", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("DireccionID", null, htmlAttributes: new { @class = "form-control" })
                @Html.ActionLink("Crear una dirección nueva", "Create", "Direcciones", new { personaID = Model.ID }, new { @class = "btn btn-outline-primary mt-2", target = "_blank" })
                @Html.ValidationMessageFor(model => model.DireccionID, "", new { @class = "text-danger" })
                <p class="help-block">La dirección nueva se abrirá en otra pestaña y volverá a esta ficha con la dirección seleccionada.</p>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<hr />
<h3>Teléfonos</h3>
@if (TempData["PersonaError"] != null) { <div class="alert alert-danger">@TempData["PersonaError"]</div> }
<div class="persona-telefonos" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:12px;">
        @foreach (var telefono in Model.TelefonosPersona)
        {
            <div style="position:relative; display:inline-flex; align-items:center; padding:6px 18px 6px 6px; border:1px solid #ccc; border-radius:4px;">
                @using (Html.BeginForm("ActualizarTelefono", "Personas", FormMethod.Post, new { style = "margin:0;" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("personaID", Model.ID)
                    @Html.Hidden("id", telefono.ID)
                    @Html.Hidden("returnTo", "Edit")
                    @Html.TextBox("telefono", telefono.TelefonoPersona1.Trim(), new { @class = "form-control", maxlength = "10", size = "10", style = "width:12ch; border:0; box-shadow:none; padding:0;", onkeydown = "if(event.key === 'Enter'){event.preventDefault(); this.form.submit();}" })
                }
                @using (Html.BeginForm("EliminarTelefono", "Personas", FormMethod.Post, new { style = "position:absolute; top:-8px; right:-8px; margin:0;" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("personaID", Model.ID)
                    @Html.Hidden("id", telefono.ID)
                    @Html.Hidden("returnTo", "Edit")
                    <button type="submit" aria-label="Eliminar teléfono" title="Eliminar teléfono" class="btn btn-danger btn-xs" style="width:20px; height:20px; padding:0; border-radius:50%; line-height:18px;">×</button>
                }
            </div>
        }
        @using (Html.BeginForm("AgregarTelefono", "Personas", FormMethod.Post, new { style = "margin:0;" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("personaID", Model.ID)
            @Html.Hidden("returnTo", "Edit")
            <div style="display:flex; align-items:center; gap:4px;">
                <input name="telefono" maxlength="10" size="10" class="form-control" style="width:12ch;" placeholder="Nuevo teléfono" aria-label="Nuevo teléfono" />
                <button type="submit" aria-label="Añadir teléfono" title="Añadir teléfono" class="btn btn-success" style="width:34px; height:34px; padding:0; font-size:22px;">+</button>
            </div>
        }
</div>

@Html.Partial("_RelacionesEntidad", Model)

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
