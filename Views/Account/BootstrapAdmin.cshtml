@model CasaGaillard.Models.ViewModels.BootstrapAdminViewModel
@{
    ViewBag.Title = "Inicializar administrador";
}

<h2>Inicializar administrador</h2>

<p>Si todavía no hay ningún usuario con el rol <strong>Administrador</strong>, puedes asignarlo a una cuenta existente.</p>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@using (Html.BeginForm("BootstrapAdmin", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.UserId, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.DropDownListFor(m => m.UserId, new SelectList(Model.Users, "Id", "Email"), "-- Selecciona un usuario --", new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-primary">Asignar Administrador</button>
            @Html.ActionLink("Volver", "Login", "Account", new { area = "" }, new { @class = "btn btn-default" })
        </div>
    </div>
}

<hr />

<h4>Usuarios detectados</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Correo</th>
            <th>Usuario</th>
            <th>Roles</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.UserName</td>
                <td>@(user.Roles == null ? "" : string.Join(", ", user.Roles))</td>
            </tr>
        }
    </tbody>
</table>
